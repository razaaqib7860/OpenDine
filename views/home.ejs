<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OpenDine — Exquisite Fine Dining & Table Reservations</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Pro / Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0F1015',
                            800: '#161922',
                            700: '#202430',
                            600: '#2C3242',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    boxShadow: {
                        'gold-glow': '0 0 30px -5px rgba(212, 175, 55, 0.25)',
                        'gold-glow-lg': '0 0 50px -5px rgba(212, 175, 55, 0.4)',
                        'glass': '0 12px 40px 0 rgba(0, 0, 0, 0.45)'
                    }
                }
            }
        }
    </script>

   <style>
    /* Full Natural Ambient Light for Architecture */
    .hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        animation: heroZoom 25s ease-in-out infinite alternate;
        filter: brightness(1.25) contrast(1.02); /* Bright, warm ambient lighting */
    }

    @keyframes heroZoom {
        from { transform: scale(1); }
        to { transform: scale(1.08); }
    }

    /* Soft Subtraction Gradient Overlay */
    .hero-overlay {
        background: radial-gradient(circle at center, rgba(15, 16, 21, 0.2) 0%, rgba(15, 16, 21, 0.75) 100%);
    }

    /* Minimalist Glassmorphism Widget */
    .glass-panel-subtle {
        background: rgba(22, 25, 34, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(212, 175, 55, 0.2);
    }

    .glass-panel {
        background: rgba(22, 25, 34, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(212, 175, 55, 0.25);
    }

    .glass-card-featured {
        background: linear-gradient(145deg, rgba(26, 30, 41, 0.9) 0%, rgba(18, 20, 28, 0.95) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(212, 175, 55, 0.2);
    }

    /* Elegant Soft Gold Text */
    .gold-text-subtle {
        color: #D4AF37;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #0F1015; }
    ::-webkit-scrollbar-thumb { background: #2C3242; border-radius: 4px; border: 1px solid rgba(212, 175, 55, 0.2); }
    ::-webkit-scrollbar-thumb:hover { background: #D4AF37; }
</style>

</head>
<body class="bg-gradient-to-b from-[#0F1015] via-[#141720] to-[#0D0E12] text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black min-h-screen">

    <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            
            <!-- Left Side: Brand & Main Navigation -->
            <div class="flex items-center space-x-12">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>

                <nav class="hidden md:flex items-center space-x-8 text-xs font-medium uppercase tracking-widest">
                    <a href="/discover" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Discover</a>
                    <a href="/restaurants" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Restaurants</a>
                    <a href="/bookings/myBookings" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">My Bookings</a>
                </nav>
            </div>

            <!-- Right Side: User Menu / Auth -->
            <div class="flex items-center space-x-6">
                <% if(locals.user) { %>
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <div class="w-8 h-8 rounded-full bg-gold-400/20 border border-gold-400/50 flex items-center justify-center text-gold-400 font-serif font-bold text-sm uppercase">
                                <%= (user?.Name || user?.email || 'U').charAt(0) %>
                            </div>
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors">
                                <%= user?.Name || 'Account' %>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>

                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user?.email || 'Not Available' %></p>
                            </div>

                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors">
                                <i class="fa-regular fa-user w-5"></i> Profile
                            </a>
                            <a href="/bookings/myBookings" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-bookmark w-5"></i> My Bookings
                            </a>

                            <% if(user?.role === 'owner') { %>
                                <a href="/owner/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-utensils w-5"></i> Owner Dashboard
                                </a>
                            <% } %>

                            <% if(user?.role === 'admin') { %>
                                <a href="/admin/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-shield-halved w-5"></i> Admin Dashboard
                                </a>
                            <% } %>

                            <div class="border-t border-white/10 mt-1"></div>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors">
                                <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/user/login" class="text-xs font-semibold uppercase tracking-widest text-white hover:text-gold-400 transition-colors">Log In</a>
                    <a href="/user/signup" class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-gold-500 to-gold-400 text-black hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                        Sign Up
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative h-screen w-full overflow-hidden flex items-center justify-center">
        
        <!-- Warm Ambient Background Image -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="hero-bg" style="background-image:url('/images/img.jpg');"></div>
        </div>

        <!-- Soft Radial Overlay -->
        <div class="absolute inset-0 z-10 hero-overlay pointer-events-none"></div>

        <!-- Minimalist Center Content Layer -->
        <div class="relative z-20 max-w-5xl mx-auto px-6 text-center pt-12 space-y-6">
            
            <!-- Elegant Top Subtitle -->
            <div class="hero-text-anim">
                <span class="text-[10px] sm:text-xs uppercase tracking-[0.35em] text-gold-400/90 font-medium px-4 py-1.5 rounded-full border border-gold-400/20 bg-black/30 backdrop-blur-md">
                    Exquisite Dining Experiences
                </span>
            </div>

            <!-- Refined Main Headline -->
            <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal text-white/95 tracking-wide leading-tight hero-text-anim">
                Curation for the <br class="hidden sm:inline">
                <span class="italic font-light text-gold-300">Discerning Palate</span>
            </h1>

            <!-- Floating Search Widget -->
            <div class="pt-6 max-w-4xl mx-auto hero-search-anim">
                <form action="/restaurants" method="GET" class="glass-panel-subtle p-3 md:p-4 rounded-2xl md:rounded-full shadow-2xl flex flex-col md:flex-row items-center justify-between gap-3 border border-white/10">
                    
                    <!-- Search Input -->
                    <div class="flex items-center w-full md:w-1/4 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                        <i class="fa-solid fa-magnifying-glass text-gold-400/80 mr-3 text-xs"></i>
                        <input type="text" name="search" placeholder="Search cuisines, restaurants..." class="w-full bg-transparent text-xs text-white placeholder-gray-300/70 focus:outline-none">
                    </div>

                    <!-- Location Input -->
                    <div class="flex items-center w-full md:w-1/4 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                        <i class="fa-solid fa-location-dot text-gold-400/80 mr-3 text-xs"></i>
                        <input type="text" name="location" placeholder="Location (e.g. London)" class="w-full bg-transparent text-xs text-white placeholder-gray-300/70 focus:outline-none">
                    </div>

                    <!-- Date Selection -->
                    <div class="flex items-center w-full md:w-1/5 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                        <i class="fa-regular fa-calendar text-gold-400/80 mr-3 text-xs"></i>
                        <input type="date" name="date" class="w-full bg-transparent text-xs text-white/90 focus:outline-none [color-scheme:dark]">
                    </div>

                    <!-- Guests Selection -->
                    <div class="flex items-center w-full md:w-1/6 px-4 py-2">
                        <i class="fa-solid fa-user-group text-gold-400/80 mr-3 text-xs"></i>
                        <select name="guests" class="w-full bg-transparent text-xs text-white/90 focus:outline-none cursor-pointer">
                            <option value="1" class="bg-dark-800 text-white">1 Guest</option>
                            <option value="2" selected class="bg-dark-800 text-white">2 Guests</option>
                            <option value="3" class="bg-dark-800 text-white">3 Guests</option>
                            <option value="4" class="bg-dark-800 text-white">4 Guests</option>
                            <option value="5+" class="bg-dark-800 text-white">5+ Guests</option>
                        </select>
                    </div>

                    <!-- CTA Button -->
                    <button type="submit" class="w-full md:w-auto px-7 py-3 rounded-full bg-gold-400 hover:bg-gold-300 text-black font-semibold text-xs uppercase tracking-widest transition-all duration-300 whitespace-nowrap shadow-md">
                        Find a Table
                    </button>
                </form>
            </div>

        </div>
    </section>

    <!-- FEATURED RESTAURANTS SECTION -->
    <section class="py-20 px-6 lg:px-12 max-w-7xl mx-auto overflow-hidden relative">
    
    <!-- Ambient Radial Lighting Effect -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-gold-400/10 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Header with Swiper Navigation Buttons -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold flex items-center gap-2">
                <i class="fa-solid fa-star text-[10px] text-gold-400"></i> Michelin Standard
            </span>
            <h2 class="font-serif text-3xl lg:text-5xl font-normal text-white mt-2">Featured Culinary Destinations</h2>
        </div>
        
        <div class="flex items-center space-x-6">
            <a href="/restaurants/featured" class="hidden sm:inline-flex items-center text-xs uppercase tracking-widest text-gold-400 hover:text-white transition-colors group">
                View Collection <i class="fa-solid fa-arrow-right ml-2 transform group-hover:translate-x-1 transition-transform"></i>
            </a>

            <!-- Swiper Navigation Arrows -->
            <div class="flex space-x-3">
                <button id="featured-prev" class="w-11 h-11 rounded-full border border-gold-400/30 hover:border-gold-400 flex items-center justify-center text-gray-300 hover:text-gold-400 transition-all bg-dark-800/80 shadow-md">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </button>
                <button id="featured-next" class="w-11 h-11 rounded-full border border-gold-400/30 hover:border-gold-400 flex items-center justify-center text-gray-300 hover:text-gold-400 transition-all bg-dark-800/80 shadow-md">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Swiper Carousel Container (Enlarged Luxury Cards Layout) -->
    <% if(locals.featuredRestaurants && featuredRestaurants.length > 0) { %>
        <div class="swiper featuredSwiper !overflow-visible">
            <div class="swiper-wrapper">
                <% featuredRestaurants.forEach(restaurant => { %>
                    <div class="swiper-slide !h-auto">
                        <div onclick="window.location.href='/restaurants/<%= restaurant.slug %>'" 
                             class="group glass-card-featured rounded-3xl overflow-hidden border border-gold-400/20 hover:border-gold-400/70 transition-all duration-500 cursor-pointer flex flex-col h-full hover:shadow-gold-glow hover:-translate-y-1.5">
                            
                            <!-- Larger Luxury Image Container -->
                            <div class="relative h-64 overflow-hidden">
                                 <%                         
    const defaultImages = [
    "/images/rest1.jpg",
    "/images/rest2.jpg",
    "/images/rest3.jpg",
    "/images/rest4.jpg",
    "/images/rest5.jpg",
    "/images/img1.jpg",
    "/images/img2.jpg",
    "/images/img3.jpg",
    "/images/img4.jpg",    
];

const randomDefault =
    defaultImages[Math.floor(Math.random() * defaultImages.length)];

const image =
    (restaurant.images && restaurant.images.length > 0)
        ? restaurant.images[0]
        : randomDefault;
%>
                                    <img src="<%= image %>" 
                                     alt="<%= restaurant.name %>" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out">
                                <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/20 to-transparent"></div>
                                
                                <!-- Badges -->
                                <div class="absolute top-4 left-4 flex gap-2">
                                    <span class="bg-dark-900/90 backdrop-blur-md px-3.5 py-1 rounded-full text-[10px] uppercase tracking-wider text-gold-400 font-semibold border border-gold-400/40 shadow-lg">
                                        <%= restaurant.cuisine %>
                                    </span>
                                </div>
                                <div class="absolute top-4 right-4">
                                    <span class="bg-black/80 backdrop-blur-md px-3.5 py-1 rounded-full text-[10px] uppercase tracking-widest text-gold-300 border border-gold-400/40 shadow-lg">
                                        Avg ₹<%= restaurant.priceRange || 1000 %> • 2 Guests
                                    </span>
                                </div>
                            </div>

                            <!-- Details Container with Refined Spacing -->
                            <div class="p-6 flex flex-col flex-grow justify-between space-y-5">
                                <div>
                                    <h3 class="font-serif text-2xl text-white group-hover:text-gold-400 transition-colors truncate">
                                        <%= restaurant.name %>
                                    </h3>
                                    
                                    <p class="text-xs text-gray-300 mt-2 flex items-center truncate">
                                        <i class="fa-solid fa-location-dot text-gold-400 mr-2 flex-shrink-0"></i>
                                        <%= restaurant.location %>
                                    </p>

                                    <% if(restaurant.chef) { %>
                                        <p class="text-xs text-gray-400 mt-1 flex items-center truncate">
                                            <i class="fa-solid fa-hat-chef text-gold-400 mr-2 flex-shrink-0"></i>
                                            Chef <%= restaurant.chef %>
                                        </p>
                                    <% } %>

                                    <div class="mt-4 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-gray-400">
                                        <span><i class="fa-regular fa-clock mr-1.5 text-gold-400"></i> <%= restaurant.openingTime || '17:00' %></span>
                                        <span class="<%= restaurant.status === 'Open' ? 'text-emerald-400' : 'text-amber-400' %> font-medium">• <%= restaurant.status || 'Accepting' %></span>
                                    </div>
                                </div>

                                <!-- CTA Button -->
                                <button class="w-full py-3.5 rounded-2xl border border-gold-400/40 text-gold-400 group-hover:bg-gradient-to-r group-hover:from-gold-500 group-hover:to-gold-400 group-hover:text-black font-semibold text-xs uppercase tracking-widest transition-all duration-300 shadow-md">
                                    Reserve Table
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } else { %>
        <div class="py-16 text-center text-gray-400 font-serif border border-white/5 rounded-2xl bg-dark-800/40">
            No featured dining destinations currently available.
        </div>
    <% } %>
</section>

<!-- Swiper Initialization Script (Responsive Card Sizing) -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (document.querySelector('.featuredSwiper')) {
            new Swiper('.featuredSwiper', {
                slidesPerView: 1,
                spaceBetween: 28,
                loop: true,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                navigation: {
                    nextEl: '#featured-next',
                    prevEl: '#featured-prev',
                },
                breakpoints: {
                    640: {
                        slidesPerView: 2,
                        spaceBetween: 24,
                    },
                    1024: {
                        slidesPerView: 3,
                        spaceBetween: 28,
                    }
                }
            });
        }
    });
</script>

  
    <!-- TRENDING SECTION -->
<section class="py-20 bg-dark-800/60 border-y border-gold-400/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-10 flex justify-between items-end">
        <div>
            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">In High Demand</span>
            <h2 class="font-serif text-4xl text-white mt-2">Trending This Week</h2>
        </div>
        <!-- Custom Swiper Controls -->
        <div class="flex space-x-3">
            <button id="trending-prev" class="w-11 h-11 rounded-full border border-gold-400/30 hover:border-gold-400 flex items-center justify-center text-white hover:text-gold-400 transition-colors bg-dark-700/60">
                <i class="fa-solid fa-chevron-left text-sm"></i>
            </button>
            <button id="trending-next" class="w-11 h-11 rounded-full border border-gold-400/30 hover:border-gold-400 flex items-center justify-center text-white hover:text-gold-400 transition-colors bg-dark-700/60">
                <i class="fa-solid fa-chevron-right text-sm"></i>
            </button>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="swiper trendingSwiper">
            <div class="swiper-wrapper">
                <% if (locals.exclusiveRestaurants && exclusiveRestaurants.length > 0) { %>
                    <% exclusiveRestaurants.forEach(restaurant => { %>
                        <!-- Dynamic Exclusive Restaurant Item -->
                        <div class="swiper-slide w-80">
                            <div onclick="window.location.href='/restaurants/<%= restaurant.slug %>'" 
                                 class="relative rounded-2xl overflow-hidden group border border-gold-400/20 hover:border-gold-400/60 transition-all duration-500 cursor-pointer shadow-lg">
    <%                         
    const defaultImages = [
    "/images/rest1.jpg",
    "/images/rest2.jpg",
    "/images/rest3.jpg",
    "/images/rest4.jpg",
    "/images/rest5.jpg",
    "/images/img1.jpg",
    "/images/img2.jpg",
    "/images/img3.jpg",
    "/images/img4.jpg",    
];

const randomDefault =
    defaultImages[Math.floor(Math.random() * defaultImages.length)];

const image =
    (restaurant.images && restaurant.images.length > 0)
        ? restaurant.images[0]
        : randomDefault;
%>
                                <img src="<%= image %>" 
                                     alt="<%= restaurant.name %>" 
                                     class="h-96 w-full object-cover group-hover:scale-105 transition-transform duration-700">
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/40 to-transparent"></div>
                                
                                <!-- Exclusive Badge -->
                                <div class="absolute top-4 right-4">
                                    <span class="bg-gold-400/20 backdrop-blur-md px-3 py-1 rounded-full text-[9px] uppercase tracking-wider text-gold-400 font-semibold border border-gold-400/40">
                                        <i class="fa-solid fa-crown mr-1"></i> Exclusive
                                    </span>
                                </div>

                                <div class="absolute bottom-6 left-6 right-6">
                                    <span class="bg-black/70 backdrop-blur-lg px-3 py-1 rounded-full text-[10px] uppercase tracking-widest text-gold-300 border border-gold-400/30 inline-block mb-2">
                                        Avg ₹<%= restaurant.priceRange || 1000 %> • 2 Guests
                                    </span>
                                    <h4 class="font-serif text-2xl text-white group-hover:text-gold-400 transition-colors truncate">
                                        <%= restaurant.name %>
                                    </h4>
                                    <p class="text-xs text-gray-300 mt-1 truncate">
                                        <i class="fa-solid fa-location-dot text-gold-400 mr-1.5"></i><%= restaurant.location %>
                                    </p>
                                    <% if (restaurant.chef) { %>
                                        <p class="text-[11px] text-gold-300/80 mt-0.5 truncate">
                                            <i class="fa-solid fa-hat-chef text-gold-400 mr-1.5"></i>Chef <%= restaurant.chef %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <!-- Fallback Static Cards -->
                    <div class="swiper-slide w-80">
                        <div class="relative rounded-2xl overflow-hidden group border border-white/10">
                            <img src="https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&q=80&w=800" class="h-96 w-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/20 to-transparent"></div>
                            <div class="absolute bottom-6 left-6 right-6">
                                <span class="text-[10px] text-gold-400 uppercase tracking-widest font-semibold">French Contemporary</span>
                                <h4 class="font-serif text-xl text-white mt-1">L'Symphonie</h4>
                                <p class="text-xs text-gray-400 mt-1">Paris • 3 Michelin Stars</p>
                            </div>
                        </div>

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OpenDine — Exquisite Fine Dining & Table Reservations</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Pro / Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Swiper Cinematic Zoom Effect */
        .swiper-slide-active .hero-bg {
            transform: scale(1.15);
            transition: transform 10s ease-out;
        }
        .hero-bg {
            transform: scale(1);
            transition: transform 0.8s ease-in-out;
        }

        /* Backdrop Blur Glassmorphism */
        .glass-panel {
            background: rgba(18, 20, 24, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        /* Gold Gradient Text */
        .gold-gradient-text {
            background: linear-[#B8860B] linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip:text;
            -webkit-text-fill-color:transparent;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black">

    <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            
            <!-- Left Side: Brand & Main Navigation -->
            <div class="flex items-center space-x-12">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>

                <nav class="hidden md:flex items-center space-x-8 text-xs font-medium uppercase tracking-widest">
                    <a href="/discover" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Discover</a>
                    <a href="/restaurants" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Restaurants</a>
                    <a href="/bookings/myBookings" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">My Bookings</a>
                </nav>
            </div>

            <!-- Right Side: User Menu / Auth -->
            <div class="flex items-center space-x-6">
                <% if(locals.user) { %>
                    <!-- Logged In Dropdown -->
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <img src="<%= user.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150' %>" 
                                 alt="<%= user.Name %>" 
                                 class="w-8 h-8 rounded-full object-cover border border-gold-400/50">
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors">
                                <%= user.Name %>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>

                        <!-- Menu Dropdown -->
                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user.email %></p>
                            </div>

                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-user w-5"></i> Profile
                            </a>
                            <a href="/bookings/myBookings" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-bookmark w-5"></i> My Bookings
                            </a>

                            <% if(user.role === 'owner') { %>
                                <a href="/owner/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-utensils w-5"></i> Owner Dashboard
                                </a>
                            <% } %>

                            <% if(user.role === 'admin') { %>
                                <a href="/admin/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-shield-halved w-5"></i> Admin Dashboard
                                </a>
                            <% } %>

                            <div class="border-t border-white/10 mt-1"></div>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors">
                                <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Guest Navigation -->
                    <a href="/user/login" class="text-xs font-semibold uppercase tracking-widest text-white hover:text-gold-400 transition-colors">Log In</a>
                    <a href="/user/signup" class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-gold-500 to-gold-400 text-black hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                        Sign Up
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative h-screen w-full overflow-hidden">
        <!-- Hero Background Swiper -->
        <div class="swiper heroSwiper h-full w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide overflow-hidden">
                    <div class="hero-bg h-full w-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=2000');"></div>
                </div>
                <div class="swiper-slide overflow-hidden">
                    <div class="hero-bg h-full w-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&q=80&w=2000');"></div>
                </div>
                <div class="swiper-slide overflow-hidden">
                    <div class="hero-bg h-full w-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?auto=format&fit=crop&q=80&w=2000');"></div>
                </div>
                <div class="swiper-slide overflow-hidden">
                    <div class="hero-bg h-full w-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&q=80&w=2000');"></div>
                </div>
                <div class="swiper-slide overflow-hidden">
                    <div class="hero-bg h-full w-full bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&q=80&w=2000');"></div>
                </div>
            </div>
        </div>

        <!-- Dark Overlay Matrix -->
        <div class="absolute inset-0 z-10 bg-gradient-to-t from-dark-900 via-dark-900/60 to-dark-900/40 pointer-events-none"></div>

        <!-- Hero Content Layer -->
        <div class="absolute inset-0 z-20 flex flex-col justify-center items-center text-center px-4 pt-20">
            <div class="max-w-4xl mx-auto space-y-6 hero-text-anim">
                <span class="inline-block text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold px-4 py-1.5 rounded-full border border-gold-400/30 glass-panel">
                    Curation for the Discerning Palate
                </span>
                <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-normal tracking-tight text-white leading-tight">
                    EXQUISITE DINING <br>
                    <span class="italic font-light gold-gradient-text">EXPERIENCES</span>
                </h1>
            </div>

            <!-- Floating Search Widget -->
            <div class="w-full max-w-5xl mt-12 px-4 hero-search-anim">
                <form action="/restaurants" method="GET" class="glass-panel p-4 md:p-6 rounded-2xl md:rounded-full shadow-2xl flex flex-col md:flex-row items-center justify-between gap-4 border border-gold-400/30">
                    
                    <!-- Search Input -->
                    <div class="flex items-center w-full md:w-1/4 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                        <i class="fa-solid fa-magnifying-glass text-gold-400 mr-3"></i>
                        <input type="text" name="search" placeholder="Restaurant or Cuisine..." class="w-full bg-transparent text-sm text-white placeholder-gray-400 focus:outline-none">
                    </div>

                    <!-- Location Input -->
                    <div class="flex items-center w-full md:w-1/4 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                        <i class="fa-solid fa-location-dot text-gold-400 mr-3"></i>
                        <input type="text" name="location" placeholder="City or Neighborhood" class="w-full bg-transparent text-sm text-white placeholder-gray-400 focus:outline-none">
                    </div>

                    <!-- Date Selection -->
                    <div class="flex items-center w-full md:w-1/5 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                        <i class="fa-regular fa-calendar text-gold-400 mr-3"></i>
                        <input type="date" name="date" class="w-full bg-transparent text-sm text-white focus:outline-none [color-scheme:dark]">
                    </div>

                    <!-- Guests Selection -->
                    <div class="flex items-center w-full md:w-1/6 px-4 py-2">
                        <i class="fa-solid fa-user-group text-gold-400 mr-3"></i>
                        <select name="guests" class="w-full bg-transparent text-sm text-white focus:outline-none cursor-pointer">
                            <option value="1" class="bg-dark-800 text-white">1 Guest</option>
                            <option value="2" selected class="bg-dark-800 text-white">2 Guests</option>
                            <option value="3" class="bg-dark-800 text-white">3 Guests</option>
                            <option value="4" class="bg-dark-800 text-white">4 Guests</option>
                            <option value="5+" class="bg-dark-800 text-white">5+ Guests</option>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="w-full md:w-auto px-8 py-4 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20 whitespace-nowrap">
                        Find Table
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- FEATURED RESTAURANTS SECTION -->
 
    <section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto overflow-hidden">
    <!-- Header with Swiper Navigation Buttons -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Michelin Standard</span>
            <h2 class="font-serif text-3xl lg:text-4xl font-normal text-white mt-2">Featured Culinary Destinations</h2>
        </div>
        
        <div class="flex items-center space-x-6">
            <a href="/restaurants/featured" class="hidden sm:inline-flex items-center text-xs uppercase tracking-widest text-gold-400 hover:text-white transition-colors group">
                View Collection <i class="fa-solid fa-arrow-right ml-2 transform group-hover:translate-x-1 transition-transform"></i>
            </a>

            <!-- Swiper Navigation Arrows -->
            <div class="flex space-x-3">
                <button id="featured-prev" class="w-10 h-10 rounded-full border border-white/10 hover:border-gold-400/60 flex items-center justify-center text-gray-300 hover:text-gold-400 transition-all bg-dark-800">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </button>
                <button id="featured-next" class="w-10 h-10 rounded-full border border-white/10 hover:border-gold-400/60 flex items-center justify-center text-gray-300 hover:text-gold-400 transition-all bg-dark-800">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Swiper Carousel Container -->
    <% if(locals.featuredRestaurants && featuredRestaurants.length > 0) { %>
        <div class="swiper featuredSwiper !overflow-visible">
            <div class="swiper-wrapper">
                <% featuredRestaurants.forEach(restaurant => { %>
                    <div class="swiper-slide !h-auto">
                        <div onclick="window.location.href='/restaurants/<%= restaurant.slug %>'" 
                             class="group bg-dark-800 rounded-2xl overflow-hidden border border-white/5 hover:border-gold-400/40 transition-all duration-500 cursor-pointer flex flex-col h-full hover:shadow-xl hover:shadow-gold-500/5">
                            
                            <!-- Medium Image Container -->
                            <div class="relative h-48 overflow-hidden">
                                <img src="<%= restaurant.images && restaurant.images.length > 0 ? restaurant.images[0] : 'https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?auto=format&fit=crop&q=80&w=800' %>" 
                                     alt="<%= restaurant.name %>" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out">
                                <div class="absolute inset-0 bg-gradient-to-t from-dark-800 via-transparent to-transparent"></div>
                                
                                <!-- Badges -->
                                <div class="absolute top-3 left-3 flex gap-2">
                                    <span class="bg-dark-900/80 backdrop-blur-md px-2.5 py-0.5 rounded-full text-[9px] uppercase tracking-wider text-gold-400 font-semibold border border-gold-400/30">
                                        <%= restaurant.cuisine %>
                                    </span>
                                </div>
                                <div class="absolute top-3 right-3">
                                    <span class="bg-black/60 backdrop-blur-md px-2 py-0.5 rounded-full text-[11px] text-white font-medium">
                                        <%= restaurant.priceRange || '$$$$' %>
                                    </span>
                                </div>
                            </div>

                            <!-- Details Container -->
                            <div class="p-5 flex flex-col flex-grow justify-between space-y-4">
                                <div>
                                    <h3 class="font-serif text-xl text-white group-hover:text-gold-400 transition-colors truncate">
                                        <%= restaurant.name %>
                                    </h3>
                                    
                                    <p class="text-[11px] text-gray-400 mt-1 flex items-center truncate">
                                        <i class="fa-solid fa-location-dot text-gold-400 mr-2 flex-shrink-0"></i>
                                        <%= restaurant.location %>
                                    </p>

                                    <% if(restaurant.chef) { %>
                                        <p class="text-[11px] text-gray-400 mt-1 flex items-center truncate">
                                            <i class="fa-solid fa-hat-chef text-gold-400 mr-2 flex-shrink-0"></i>
                                            Chef <%= restaurant.chef %>
                                        </p>
                                    <% } %>

                                    <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-gray-400">
                                        <span><i class="fa-regular fa-clock mr-1 text-gold-400"></i> <%= restaurant.openingTime || '17:00' %></span>
                                        <span class="<%= restaurant.status === 'Open' ? 'text-emerald-400' : 'text-amber-400' %> font-medium">• <%= restaurant.status || 'Accepting' %></span>
                                    </div>
                                </div>

                                <!-- CTA Button -->
                                <button class="w-full py-2.5 rounded-xl border border-gold-400/30 text-gold-400 group-hover:bg-gold-400 group-hover:text-black font-semibold text-[11px] uppercase tracking-widest transition-all duration-300">
                                    Reserve Table
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } else { %>
        <div class="py-12 text-center text-gray-500 font-serif">
            No featured dining destinations currently available.
        </div>
    <% } %>
</section>
<!-- Swiper Initialization Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (document.querySelector('.featuredSwiper')) {
            new Swiper('.featuredSwiper', {
                slidesPerView: 1,
                spaceBetween: 20,
                loop: true,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                navigation: {
                    nextEl: '#featured-next',
                    prevEl: '#featured-prev',
                },
                breakpoints: {
                    640: {
                        slidesPerView: 2,
                        spaceBetween: 20,
                    },
                    1024: {
                        slidesPerView: 3,
                        spaceBetween: 24,
                    },
                    1280: {
                        slidesPerView: 4,
                        spaceBetween: 24,
                    }
                }
            });
        }
    });
</script>

  
    <!-- TRENDING SECTION -->
<section class="py-24 bg-dark-800 border-y border-white/5 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-12 flex justify-between items-end">
        <div>
            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">In High Demand</span>
            <h2 class="font-serif text-4xl text-white mt-2">Trending This Week</h2>
        </div>
        <!-- Custom Swiper Controls -->
        <div class="flex space-x-3">
            <button id="trending-prev" class="w-12 h-12 rounded-full border border-white/10 hover:border-gold-400 flex items-center justify-center text-white hover:text-gold-400 transition-colors">
                <i class="fa-solid fa-chevron-left text-sm"></i>
            </button>
            <button id="trending-next" class="w-12 h-12 rounded-full border border-white/10 hover:border-gold-400 flex items-center justify-center text-white hover:text-gold-400 transition-colors">
                <i class="fa-solid fa-chevron-right text-sm"></i>
            </button>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="swiper trendingSwiper">
            <div class="swiper-wrapper">
                <% if (locals.exclusiveRestaurants && exclusiveRestaurants.length > 0) { %>
                    <% exclusiveRestaurants.forEach(restaurant => { %>
                        <!-- Dynamic Exclusive Restaurant Item -->
                        <div class="swiper-slide w-80">
                            <div onclick="window.location.href='/restaurants/<%= restaurant.slug %>'" 
                                 class="relative rounded-2xl overflow-hidden group border border-white/5 hover:border-gold-400/40 transition-all duration-500 cursor-pointer">
                                
                                <img src="<%= (restaurant.images && restaurant.images.length > 0) ? restaurant.images[0] : 'https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&q=80&w=800' %>" 
                                     alt="<%= restaurant.name %>" 
                                     class="h-96 w-full object-cover group-hover:scale-105 transition-transform duration-700">
                                
                                <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/30 to-transparent"></div>
                                
                                <!-- Exclusive Badge -->
                                <div class="absolute top-4 right-4">
                                    <span class="bg-gold-400/20 backdrop-blur-md px-3 py-1 rounded-full text-[9px] uppercase tracking-wider text-gold-400 font-semibold border border-gold-400/40">
                                        <i class="fa-solid fa-crown mr-1"></i> Exclusive
                                    </span>
                                </div>

                                <div class="absolute bottom-6 left-6 right-6">
                                    <span class="text-[10px] text-gold-400 uppercase tracking-widest font-semibold">
                                        <%= restaurant.cuisine %> • <%= restaurant.priceRange || '$$$$' %>
                                    </span>
                                    <h4 class="font-serif text-xl text-white mt-1 group-hover:text-gold-400 transition-colors truncate">
                                        <%= restaurant.name %>
                                    </h4>
                                    <p class="text-xs text-gray-400 mt-1 truncate">
                                        <i class="fa-solid fa-location-dot text-gold-400 mr-1.5"></i><%= restaurant.location %>
                                    </p>
                                    <% if (restaurant.chef) { %>
                                        <p class="text-[11px] text-gold-300/80 mt-0.5 truncate">
                                            <i class="fa-solid fa-hat-chef text-gold-400 mr-1.5"></i>Chef <%= restaurant.chef %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <!-- Fallback Static Cards (If no database items found) -->
                    <div class="swiper-slide w-80">
                        <div class="relative rounded-2xl overflow-hidden group border border-white/5">
                            <img src="https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&q=80&w=800" class="h-96 w-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/20 to-transparent"></div>
                            <div class="absolute bottom-6 left-6 right-6">
                                <span class="text-[10px] text-gold-400 uppercase tracking-widest font-semibold">French Contemporary</span>
                                <h4 class="font-serif text-xl text-white mt-1">L'Symphonie</h4>
                                <p class="text-xs text-gray-400 mt-1">Paris • 3 Michelin Stars</p>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide w-80">
                        <div class="relative rounded-2xl overflow-hidden group border border-white/5">
                            <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&q=80&w=800" class="h-96 w-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/20 to-transparent"></div>
                            <div class="absolute bottom-6 left-6 right-6">
                                <span class="text-[10px] text-gold-400 uppercase tracking-widest font-semibold">Omakase & Kaiseki</span>
                                <h4 class="font-serif text-xl text-white mt-1">Kyoto Miyabi</h4>
                                <p class="text-xs text-gray-400 mt-1">Tokyo • Exclusive 8-Seat</p>
                            </div>
                        </div>
                    </div>

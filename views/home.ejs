    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    
    <!-- GSAP Animation Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

    <!-- Vanilla Javascript Logic -->
    <script>
        // 1. Sticky Navbar Effect on Scroll
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('glass-panel', 'py-4');
                navbar.classList.remove('py-6');
            } else {
                navbar.classList.remove('glass-panel', 'py-4');
                navbar.classList.add('py-6');
            }
        });

        // 2. User Dropdown Menu Toggle
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const dropdownArrow = document.getElementById('dropdown-arrow');

        if (userMenuBtn && userDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userDropdown.classList.contains('hidden');
                
                if (isHidden) {
                    userDropdown.classList.remove('hidden');
                    setTimeout(() => {
                        userDropdown.classList.remove('opacity-0', 'scale-95');
                        userDropdown.classList.add('opacity-100', 'scale-100');
                        dropdownArrow.classList.add('rotate-180');
                    }, 10);
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                    closeDropdown();
                }
            });

            function closeDropdown() {
                userDropdown.classList.remove('opacity-100', 'scale-100');
                userDropdown.classList.add('opacity-0', 'scale-95');
                if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
                setTimeout(() => {
                    userDropdown.classList.add('hidden');
                }, 200);
            }
        }

        // 3. Hero Section Swiper Initialization
        const heroSwiper = new Swiper('.heroSwiper', {
            effect: 'fade',
            fadeEffect: { crossFade: true },
            loop: true,
            autoplay: {
                delay: 6000,
                disableOnInteraction: false,
            },
            speed: 1500,
        });

        // 4. Trending Section Swiper Initialization
        const trendingSwiper = new Swiper('.trendingSwiper', {
            slidesPerView: 'auto',
            spaceBetween: 24,
            loop: true,
            navigation: {
                nextEl: '#trending-next',
                prevEl: '#trending-prev',
            },
        });

        // 5. GSAP Entrance Animations
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from('.hero-text-anim', {
                opacity: 0,
                y: 40,
                duration: 1.2,
                ease: 'power3.out',
                delay: 0.2
            });

            gsap.from('.hero-search-anim', {
                opacity: 0,
                y: 40,
                duration: 1.2,
                ease: 'power3.out',
                delay: 0.5
            });
        });
    </script>

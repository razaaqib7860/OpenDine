<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discover Extraordinary Dining — OpenDine</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .glass-panel {
            background: rgba(18, 20, 24, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black">

     <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            
            <!-- Left Side: Brand & Main Navigation -->
            <div class="flex items-center space-x-12">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>

                <nav class="hidden md:flex items-center space-x-8 text-xs font-medium uppercase tracking-widest">
                    <a href="/discover" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Discover</a>
                    <a href="/restaurants" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Restaurants</a>
                    <a href="/bookings/myBookings" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">My Bookings</a>
                </nav>
            </div>

            <!-- Right Side: User Menu / Auth -->
            <div class="flex items-center space-x-6">
                <% if(locals.user) { %>
                    <!-- Logged In Dropdown -->
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <img src="<%= user.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150' %>" 
                                 alt="<%= user.Name %>" 
                                 class="w-8 h-8 rounded-full object-cover border border-gold-400/50">
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors">
                                <%= user.Name %>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>

                        <!-- Menu Dropdown -->
                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user.email %></p>
                            </div>

                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-user w-5"></i> Profile
                            </a>
                            <a href="/bookings/myBookings" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-bookmark w-5"></i> My Bookings
                            </a>

                            <% if(user.role === 'owner') { %>
                                <a href="/owner/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-utensils w-5"></i> Owner Dashboard
                                </a>
                            <% } %>

                            <% if(user.role === 'admin') { %>
                                <a href="/admin/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-shield-halved w-5"></i> Admin Dashboard
                                </a>
                            <% } %>

                            <div class="border-t border-white/10 mt-1"></div>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors">
                                <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Guest Navigation -->
                    <a href="/user/login" class="text-xs font-semibold uppercase tracking-widest text-white hover:text-gold-400 transition-colors">Log In</a>
                    <a href="/user/signup" class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-gold-500 to-gold-400 text-black hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                        Sign Up
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- SECTION 1: HERO BANNER -->
    <section class="relative h-[85vh] min-h-[600px] w-full overflow-hidden flex items-center justify-center">
        <div class="absolute inset-0 bg-cover bg-center scale-105 transition-transform duration-10000 ease-out" style="background-image: url('/images/hero_img.png');" id="hero-bg"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/60 to-dark-900/40"></div>

        <div class="relative z-10 max-w-5xl mx-auto px-6 text-center space-y-6 pt-16 hero-content-anim">
            <span class="inline-block text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold px-4 py-1.5 rounded-full border border-gold-400/30 glass-panel">
                Curated High Culinary Directory
            </span>
          <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-normal tracking-tight leading-tight text-[#F5F1E8] drop-shadow-[0_6px_30px_rgba(0,0,0,0.55)]">
    Discover
    <span class="italic font-light text-[#C8A04A]">Extraordinary</span>
    Dining
</h1>
            <p class="text-xs md:text-sm text-gray-300 max-w-2xl mx-auto font-light leading-relaxed">
                Explore handpicked fine dining destinations curated for unforgettable culinary journeys across world-class hubs.
            </p>
        </div>
    </section>

    <!-- SECTION 2: FLOATING SEARCH BAR -->
    <section class="max-w-6xl mx-auto px-6 -mt-20 relative z-30 search-anim">
        <form action="/restaurants" method="GET" class="glass-panel p-4 md:p-6 rounded-2xl md:rounded-full shadow-2xl flex flex-col md:flex-row items-center justify-between gap-3 border border-gold-400/30">
            
            <!-- Restaurant Search -->
            <div class="flex items-center w-full md:w-1/5 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                <i class="fa-solid fa-magnifying-glass text-gold-400 mr-3 text-xs"></i>
                <input type="text" name="search" placeholder="Search Restaurant..." class="w-full bg-transparent text-xs text-white placeholder-gray-400 focus:outline-none">
            </div>

            <!-- Cuisine -->
            <div class="flex items-center w-full md:w-1/5 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                <i class="fa-solid fa-utensils text-gold-400 mr-3 text-xs"></i>
                <input type="text" name="cuisine" placeholder="Search Cuisine..." class="w-full bg-transparent text-xs text-white placeholder-gray-400 focus:outline-none">
            </div>

            <!-- City -->
            <div class="flex items-center w-full md:w-1/5 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                <i class="fa-solid fa-location-dot text-gold-400 mr-3 text-xs"></i>
                <input type="text" name="location" placeholder="City or District..." class="w-full bg-transparent text-xs text-white placeholder-gray-400 focus:outline-none">
            </div>

            <!-- Date -->
            <div class="flex items-center w-full md:w-1/6 px-4 py-2 border-b md:border-b-0 md:border-r border-white/10">
                <i class="fa-regular fa-calendar text-gold-400 mr-3 text-xs"></i>
                <input type="date" name="date" class="w-full bg-transparent text-xs text-white focus:outline-none [color-scheme:dark]">
            </div>

            <!-- Guests -->
            <div class="flex items-center w-full md:w-1/6 px-4 py-2">
                <i class="fa-solid fa-user-group text-gold-400 mr-3 text-xs"></i>
                <select name="guests" class="w-full bg-transparent text-xs text-white focus:outline-none cursor-pointer">
                    <option value="1" class="bg-dark-800">1 Guest</option>
                    <option value="2" selected class="bg-dark-800">2 Guests</option>
                    <option value="3" class="bg-dark-800">3 Guests</option>
                    <option value="4" class="bg-dark-800">4 Guests</option>
                    <option value="5+" class="bg-dark-800">5+ Guests</option>
                </select>
            </div>

            <button type="submit" class="w-full md:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20 whitespace-nowrap">
                Find Table
            </button>
        </form>
    </section>

   <!-- SECTION 3: FEATURED CITIES -->
<!-- SECTION 3: FEATURED CITIES -->
<section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="inline-block text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold px-4 py-1.5 rounded-full border border-gold-400/30 glass-panel">
            Epicurean Map
        </span>
        <h2 class="font-serif text-4xl lg:text-5xl font-normal text-white">Top Indian Dining Cities</h2>
        <p class="text-xs text-gray-300">Explore hand-vetted luxury tables across India's leading culinary destinations.</p>
    </div>

    <!-- 6 City Identity Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
       
       <% const cities = [
            { 
                name: 'Kolkata', 
                count: '90+ Establishments', 
                fineCount: '30 Heritage & Fine Dining', 
                img: 'https://images.unsplash.com/photo-1558431382-27e303142255?auto=format&fit=crop&q=80&w=800' 
            },
             { 
                name: 'Ranchi', 
                count: '50+ Establishments', 
                fineCount: '15 Fine Dining', 
                img: '/images/dhoni.png?auto=format&fit=crop&q=80&w=800' 
            },
            { 
                name: 'Delhi', 
                count: '110+ Establishments', 
                fineCount: '38 Michelin Standard', 
                img: 'https://images.unsplash.com/photo-1587474260584-136574528ed5?auto=format&fit=crop&q=80&w=800' 
            },
            { 
                name: 'Hyderabad', 
                count: '85+ Establishments', 
                fineCount: '28 Royal Fine Dining', 
                img: '/images/charminar.jpg'
            },
            
            { 
                name: 'Mumbai', 
                count: '120+ Establishments', 
                fineCount: '45 Michelin Standard', 
                img: 'https://images.unsplash.com/photo-1570168007204-dfb528c6958f?auto=format&fit=crop&q=80&w=800' 
            },
            { 
                name: 'Chennai', 
                count: '75+ Establishments', 
                fineCount: '25 Coastal Luxury', 
                img: 'https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&q=80&w=800' 
            }
        ]; %>

        <% cities.forEach(city => { %>
            <a href="/restaurants?location=<%= city.name %>" class="group relative h-96 rounded-3xl overflow-hidden border border-gold-400/30 hover:border-gold-400 transition-all duration-500 shadow-2xl block bg-dark-800">
                
                <!-- THE IMG TAG -->
                <img src="<%= city.img %>" 
                     alt="<%= city.name %>" 
                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&q=80&w=800';" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out">
                
                <!-- Overlay & Card Details -->
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
                
                <div class="absolute bottom-6 left-6 right-6 space-y-2 z-10">
                    <span class="inline-block text-[10px] uppercase tracking-widest text-gold-400 font-bold px-3 py-1 rounded-full border border-gold-400/50 bg-black/60 backdrop-blur-md shadow-md">
                        <%= city.fineCount %>
                    </span>
                    <h3 class="font-serif text-3xl text-white group-hover:text-gold-400 transition-colors drop-shadow-lg"><%= city.name %></h3>
                    <p class="text-xs text-gray-200 flex items-center justify-between pt-2 border-t border-white/20">
                        <span class="font-medium"><%= city.count %></span>
                        <i class="fa-solid fa-arrow-right text-gold-400 group-hover:translate-x-2 transition-transform"></i>
                    </p>
                </div>
            </a>
        <% }); %>
    </div>
</section>

    <!-- SECTION 4: CUISINE COLLECTION -->
    <section class="py-24 bg-dark-800 border-y border-white/5 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-12 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Gastronomic Spectrum</span>
                <h2 class="font-serif text-4xl text-white mt-2">Cuisine Collections</h2>
            </div>
            <p class="text-xs text-gray-400 max-w-md">Filter by authentic culinary techniques, heritage recipes, and contemporary gastronomy.</p>
        </div>

        <!-- Horizontal Scrollable Cards -->
        <div class="flex space-x-6 overflow-x-auto no-scrollbar px-6 lg:px-12 pb-6">
            <% const cuisines = [
                { title: 'Italian', desc: 'Artisanal Pasta & Truffles', img: 'https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&q=80&w=600' },
                { title: 'Japanese', desc: 'Omakase & Edomae Sushi', img: 'https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&q=80&w=600' },
                { title: 'French', desc: 'Haute Cuisine & Cellars', img: 'https://images.unsplash.com/photo-1600891964092-4316c288032e?auto=format&fit=crop&q=80&w=600' },
                { title: 'Indian', desc: 'Royal Mughlai & Heritage', img: 'https://images.unsplash.com/photo-1585937421612-70a008356fbe?auto=format&fit=crop&q=80&w=600' },
                { title: 'Mediterranean', desc: 'Coastal Olive & Charcoal', img: 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=600' },
                { title: 'Steakhouse', desc: 'A5 Wagyu & Dry Aged', img: 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=600' },
                { title: 'Seafood', desc: 'Ocean Shellfish Reserve', img: 'https://images.unsplash.com/photo-1534422298391-e4f8c172dddb?auto=format&fit=crop&q=80&w=600' },
                { title: 'Asian Fusion', desc: 'Modern Pan-Asian Taste', img: 'https://images.unsplash.com/photo-1512058564366-18510be2db19?auto=format&fit=crop&q=80&w=600' }
            ]; %>

            <% cuisines.forEach(c => { %>
                <a href="/restaurants?cuisine=<%= c.title %>" class="flex-shrink-0 w-72 rounded-2xl overflow-hidden glass-panel border border-white/10 hover:border-gold-400/50 transition-all group block">
                    <div class="h-44 relative overflow-hidden">
                        <img src="<%= c.img %>" alt="<%= c.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                        <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-transparent to-transparent"></div>
                    </div>
                    <div class="p-5">
                        <h4 class="font-serif text-xl text-white group-hover:text-gold-400 transition-colors"><%= c.title %></h4>
                        <p class="text-xs text-gray-400 mt-1"><%= c.desc %></p>
                    </div>
                </a>
            <% }); %>
        </div>
    </section>

    <!-- SECTION 5: LUXURY EXPERIENCES -->
    <section class="py-28 px-6 lg:px-12 max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Tailored Moments</span>
            <h2 class="font-serif text-4xl lg:text-5xl font-normal text-white">Curated Dining Experiences</h2>
            <p class="text-xs text-gray-400">Select an environment perfectly suited to your special occasion.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% const experiences = [
                { title: 'Rooftop Dining', icon: 'fa-building-columns', desc: 'Panoramic skyline vistas paired with sommelier selections.', img: '/images/rooftop.jpg' },
                { title: 'Romantic Date Night', icon: 'fa-wine-glass-sparkles', desc: 'Intimate candlelit seating, private booths, and champagne.', img: '/images/romantic.jpg' },
                { title: 'Business Meetings', icon: 'fa-briefcase', desc: 'Private dining rooms with high security and quiet ambiance.', img: '/images/business.jpg' },
                { title: 'Family Gatherings', icon: 'fa-people-roof', desc: 'Expansive family tables, tasting menus, and valet service.', img: '/images/family.jpg' },
                { title: 'Celebrity Chef', icon: 'fa-hat-chef', desc: 'Establishments helmed by globally lauded master chefs.', img: '/images/chef.jpg' },
                { title: 'Michelin Inspired', icon: 'fa-award', desc: 'Standardized excellence in service, wine, and gastronomy.', img: '/images/bar.jpg' }
            ]; %>

            <% experiences.forEach(exp => { %>
                <div class="glass-panel rounded-3xl overflow-hidden border border-white/10 hover:border-gold-400/40 transition-all duration-500 group flex flex-col justify-between">
                    <div class="h-48 relative overflow-hidden">
                        <img src="<%= exp.img %>" alt="<%= exp.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                        <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-transparent to-transparent"></div>
                    </div>
                    <div class="p-6 space-y-3">
                        <div class="w-10 h-10 rounded-full bg-gold-400/10 border border-gold-400/30 flex items-center justify-center text-gold-400 text-sm">
                            <i class="fa-solid <%= exp.icon %>"></i>
                        </div>
                        <h4 class="font-serif text-2xl text-white group-hover:text-gold-400 transition-colors"><%= exp.title %></h4>
                        <p class="text-xs text-gray-400 leading-relaxed"><%= exp.desc %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- SECTION 6: CTA BANNER -->
    <section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto">
        <div class="glass-panel p-12 md:p-20 rounded-3xl text-center relative overflow-hidden border border-gold-400/30 space-y-6">
            <div class="absolute -top-24 -right-24 w-60 h-60 bg-gold-400/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <span class="text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold">Immediate Priority Desk</span>
            <h2 class="font-serif text-4xl md:text-6xl text-white max-w-2xl mx-auto leading-tight">
                Reserve Your Next <span class="italic font-light text-[#C8A04A]">Extraordinary</span> Evening
            </h2>
            <p class="text-xs text-gray-400 max-w-md mx-auto leading-relaxed">
                Unlock instant access to premier dining rooms, chef counter seats, and private champagne lounges nationwide.
            </p>

            <div class="pt-4">
                <a href="/restaurants" class="inline-block px-10 py-4 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-xl shadow-gold-500/20">
                    Explore Restaurants
                </a>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-dark-900 border-t border-white/10 pt-20 pb-12 text-gray-400">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
                <div class="space-y-4">
                    <a href="/" class="flex items-center space-x-3">
                        <span class="w-8 h-8 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 font-serif font-bold">O</span>
                        <span class="font-serif text-xl tracking-widest text-white font-semibold uppercase">Open<span class="text-gold-400">Dine</span></span>
                    </a>
                    <p class="text-xs text-gray-500 leading-relaxed">
                        The premier table booking platform for Michelin-starred and luxury culinary destinations.
                    </p>
                </div>

                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Platform</h5>
                    <ul class="space-y-2.5 text-xs">
                        <li><a href="/discover" class="hover:text-gold-400 transition-colors">Discover</a></li>
                        <li><a href="/restaurants" class="hover:text-gold-400 transition-colors">Restaurants</a></li>
                        <li><a href="/about" class="hover:text-gold-400 transition-colors">About Us</a></li>
                        <li><a href="/privacy" class="hover:text-gold-400 transition-colors">Privacy Policy</a></li>

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Reservations — OpenDine Luxury Concierge</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Pro / Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Glassmorphism Styles */
        .glass-panel {
            background: rgba(18, 20, 24, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        /* Gold Gradient Text */
        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Timeline Connector Lines */
        .timeline-line::before {
            content: '';
            position: absolute;
            left: 19px;
            top: 40px;
            bottom: -20px;
            width: 2px;
            background: rgba(212, 175, 55, 0.2);
        }

        .timeline-item:last-child .timeline-line::before {
            display: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black min-h-screen flex flex-col justify-between">

    <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            
            <!-- Left Side: Brand & Main Navigation -->
            <div class="flex items-center space-x-12">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>

                <nav class="hidden md:flex items-center space-x-8 text-xs font-medium uppercase tracking-widest">
                    <a href="/discover" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Discover</a>
                    <a href="/restaurants" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Restaurants</a>
                    <a href="/bookings/myBookings" class="text-gold-400 font-semibold transition-colors duration-300">My Bookings</a>
                </nav>
            </div>

            <!-- Right Side: User Menu / Auth -->
            <div class="flex items-center space-x-6">
                <% if(locals.user) { %>
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <img src="<%= user.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150' %>" 
                                 alt="<%= user.Name %>" 
                                 class="w-8 h-8 rounded-full object-cover border border-gold-400/50">
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors">
                                <%= user.Name %>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>

                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user.email %></p>
                            </div>

                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-user w-5"></i> Profile
                            </a>
                            <a href="/bookings/myBookings" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors">
                                <i class="fa-regular fa-bookmark w-5"></i> My Bookings
                            </a>

                            <% if(user.role === 'owner') { %>
                                <a href="/owner/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-utensils w-5"></i> Owner Dashboard
                                </a>
                            <% } %>

                            <% if(user.role === 'admin') { %>
                                <a href="/admin/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-shield-halved w-5"></i> Admin Dashboard
                                </a>
                            <% } %>

                            <div class="border-t border-white/10 mt-1"></div>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors">
                                <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/user/login" class="text-xs font-semibold uppercase tracking-widest text-white hover:text-gold-400 transition-colors">Log In</a>
                    <a href="/user/signup" class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-gold-500 to-gold-400 text-black hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                        Sign Up
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- HEADER / HERO SECTION -->
    <section class="pt-36 pb-12 px-6 lg:px-12 max-w-7xl mx-auto w-full">
        <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-white/10 pb-8 gap-4 header-anim">
            <div>
                <span class="text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold px-3 py-1 rounded-full border border-gold-400/30 glass-panel">
                    Personal Concierge
                </span>
                <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal text-white mt-4">
                    My <span class="italic gold-gradient-text">Reservations</span>
                </h1>
            </div>
            <p class="text-xs text-gray-400 max-w-md leading-relaxed">
                Manage your active table reservations, review past fine dining experiences, or modify upcoming itinerary requests.
            </p>
        </div>
    </section>

    <!-- MAIN RESERVATIONS SECTION -->
    <main class="max-w-7xl mx-auto px-6 lg:px-12 pb-24 w-full flex-grow">
        <% if (locals.bookings && bookings.length > 0) { %>
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
                
                <!-- LEFT COLUMN: BOOKING CARDS LIST -->
                <div class="lg:col-span-2 space-y-8">
                    <% bookings.forEach((booking, index) => { %>
                        <% 
                            const isCancelled = booking.status && booking.status.toLowerCase() === 'cancelled';
                            const isCompleted = booking.status && booking.status.toLowerCase() === 'completed';
                            const isConfirmed = !isCancelled && !isCompleted;

                            // Format image URL
                            const resImage = (booking.restaurant && booking.restaurant.images && booking.restaurant.images.length > 0) 
                                ? booking.restaurant.images[0] 
                                : 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=800';
                        %>

                        <div class="glass-panel rounded-3xl overflow-hidden border border-white/10 hover:border-gold-400/40 transition-all duration-500 shadow-xl group booking-card-anim">
                            <div class="flex flex-col sm:flex-row">
                                
                                <!-- Restaurant Image -->
                                <div class="relative sm:w-2/5 h-64 sm:h-auto overflow-hidden flex-shrink-0">
                                    <img src="<%= resImage %>" 
                                         alt="<%= booking.restaurant ? booking.restaurant.name : 'Restaurant' %>" 
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                                    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-transparent to-transparent sm:hidden"></div>
                                    
                                    <!-- Mobile Badge -->
                                    <div class="absolute top-4 left-4 sm:hidden">
                                        <% if(isConfirmed) { %>
                                            <span class="px-3 py-1 rounded-full text-[10px] uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-semibold backdrop-blur-md">
                                                <i class="fa-solid fa-circle-check mr-1"></i> Confirmed
                                            </span>
                                        <% } else if(isCompleted) { %>
                                            <span class="px-3 py-1 rounded-full text-[10px] uppercase tracking-wider bg-gold-400/20 text-gold-400 border border-gold-400/40 font-semibold backdrop-blur-md">
                                                <i class="fa-solid fa-circle-dot mr-1"></i> Completed
                                            </span>
                                        <% } else { %>
                                            <span class="px-3 py-1 rounded-full text-[10px] uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/40 font-semibold backdrop-blur-md">
                                                <i class="fa-solid fa-circle-xmark mr-1"></i> Cancelled
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Card Content -->
                                 
                                <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow space-y-6">
                                    
                                    <div>
                                        <!-- Header & Desktop Status Badge -->
                                        <div class="flex items-start justify-between gap-4">
                                            <div>
                                                <h3 class="font-serif text-2xl text-white group-hover:text-gold-400 transition-colors">
                                                    <%= booking.restaurant ? booking.restaurant.name : 'Luxury Establishment' %>
                                                </h3>
                                                <p class="text-xs text-gray-400 mt-1 flex items-center">
                                                    <i class="fa-solid fa-location-dot text-gold-400 mr-2"></i>
                                                    <%= booking.restaurant ? (booking.restaurant.location + ' — ' + (booking.restaurant.address || '')) : 'Exclusive Location' %>
                                                </p>
                                            </div>

                                            <!-- Desktop Badge -->
                                            <div class="hidden sm:block flex-shrink-0">
                                                <% if(isConfirmed) { %>
                                                    <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-semibold shadow-sm">
                                                        <i class="fa-solid fa-circle-check mr-1.5"></i> Confirmed
                                                    </span>
                                                <% } else if(isCompleted) { %>
                                                    <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-wider bg-gold-400/10 text-gold-400 border border-gold-400/30 font-semibold shadow-sm">
                                                        <i class="fa-solid fa-circle-dot mr-1.5"></i> Completed
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-wider bg-red-500/10 text-red-400 border border-red-500/30 font-semibold shadow-sm">
                                                        <i class="fa-solid fa-circle-xmark mr-1.5"></i> Cancelled
                                                    </span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <!-- Key Details Grid -->
                                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-white/10">
                                            <div>
                                                <span class="text-[10px] uppercase tracking-widest text-gray-400 block">Date</span>
                                                <span class="text-xs text-white font-semibold mt-1 flex items-center">
                                                    <i class="fa-regular fa-calendar text-gold-400 mr-1.5"></i> <%= new Date(booking.date).toLocaleDateString("en-IN", {
                                                         weekday: "short",
                                                         day: "numeric",
                                                         month: "short",
                                                         year: "numeric"
                                                       })%>
                                                </span>
                                            </div>

                                            <div>
                                                <span class="text-[10px] uppercase tracking-widest text-gray-400 block">Time</span>
                                                <span class="text-xs text-gold-400 font-semibold mt-1 flex items-center">
                                                    <i class="fa-regular fa-clock text-gold-400 mr-1.5"></i> <%= booking.time %>
                                                </span>
                                            </div>

                                            <div>
                                                <span class="text-[10px] uppercase tracking-widest text-gray-400 block">Guests</span>
                                                <span class="text-xs text-white font-semibold mt-1 flex items-center">
                                                    <i class="fa-solid fa-user-group text-gold-400 mr-1.5"></i> <%= booking.guests %> <%= booking.guests == 1 ? 'Guest' : 'Guests' %>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Occasion & Requests -->
                                        <% if(booking.occasion || booking.specialRequests) { %>
                                            <div class="mt-4 pt-4 border-t border-white/5 text-xs text-gray-400 space-y-1">
                                                <% if(booking.occasion) { %>
                                                    <p><span class="text-gold-400/80 font-medium">Occasion:</span> <%= booking.occasion %></p>
                                                <% } %>
                                                <% if(booking.specialRequests) { %>
                                                    <p class="italic"><span class="text-gold-400/80 font-medium not-italic">Notes:</span> "<%= booking.specialRequests %>"</p>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
                                        <% if(booking.restaurant && booking.restaurant.slug) { %>
                                            <a href="/restaurants/<%= booking.restaurant.slug %>" 
                                               class="w-full sm:w-auto px-6 py-3 rounded-full border border-white/10 text-gray-300 hover:border-gold-400 hover:text-gold-400 font-semibold text-xs uppercase tracking-widest transition-all text-center">
                                                View Restaurant
                                            </a>
                                        <% } %>

                                        <% if(isCancelled) { %>
                                            <button disabled class="w-full sm:w-auto px-6 py-3 rounded-full border border-white/5 bg-dark-800/50 text-gray-600 font-semibold text-xs uppercase tracking-widest cursor-not-allowed text-center">
                                                Reservation Cancelled
                                            </button>
                                        <% } else if(isCompleted) { %>
                                            <button disabled class="w-full sm:w-auto px-6 py-3 rounded-full border border-white/5 bg-dark-800/50 text-gold-400/50 font-semibold text-xs uppercase tracking-widest cursor-not-allowed text-center">
                                                Fulfilled
                                            </button>
                                        <% } else { %>
                                            <form action="/bookings/cancel/<%= booking._id %>" method="POST" onsubmit="return confirmCancellation(event)" class="w-full sm:w-auto">
                                                <button type="submit" class="w-full sm:w-auto px-6 py-3 rounded-full border border-red-500/30 text-red-400 hover:bg-red-500/10 hover:border-red-400 font-semibold text-xs uppercase tracking-widest transition-all text-center">
                                                    Cancel Reservation
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>

                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- RIGHT COLUMN: BOOKING HISTORY TIMELINE -->
                <div class="lg:col-span-1 glass-panel p-8 rounded-3xl border border-gold-400/20 sticky top-28 space-y-6">
                    <div class="border-b border-white/10 pb-4">
                        <span class="text-[10px] uppercase tracking-[0.25em] text-gold-400 font-semibold">Concierge Log</span>
                        <h3 class="font-serif text-2xl text-white mt-1">Activity Timeline</h3>
                    </div>

                    <div class="space-y-6 relative pl-2">
                        <% bookings.forEach((booking, idx) => { %>
                            <div class="relative pl-8 timeline-item timeline-line">
                                <!-- Status Bullet Dot -->
                                <div class="absolute left-0 top-1 w-5 h-5 rounded-full border flex items-center justify-center
                                     <%= booking.status && booking.status.toLowerCase() === 'cancelled' 
                                        ? 'border-red-500 bg-red-500/10 text-red-400' 
                                        : (booking.status && booking.status.toLowerCase() === 'completed'
                                            ? 'border-gold-400 bg-gold-400/10 text-gold-400'
                                            : 'border-emerald-500 bg-emerald-500/10 text-emerald-400') %> text-[9px]">
                                    <i class="fa-solid <%= booking.status && booking.status.toLowerCase() === 'cancelled' ? 'fa-xmark' : 'fa-check' %>"></i>
                                </div>

                                <div>
                                    <span class="text-[10px] uppercase tracking-wider text-gold-400 font-semibold"><%= booking.date %> • <%= booking.time %></span>
                                    <h5 class="text-sm font-semibold text-white mt-0.5"><%= booking.restaurant ? booking.restaurant.name : 'Exclusive Dining' %></h5>
                                    <p class="text-xs text-gray-400 capitalize mt-0.5">Status: <%= booking.status || 'Confirmed' %></p>
                                </div>
                            </div>
                        <% }); %>
                    </div>

                    <div class="pt-4 border-t border-white/10 text-center">
                        <p class="text-[10px] text-gray-500 uppercase tracking-widest">
                            <i class="fa-solid fa-shield-halved text-gold-400 mr-1"></i> OpenDine Guarantee
                        </p>
                    </div>
                </div>

            </div>

        <% } else { %>

            <!-- EMPTY STATE -->
            <div class="glass-panel rounded-3xl p-12 sm:p-20 text-center border border-white/10 max-w-2xl mx-auto my-12 space-y-6 empty-state-anim">
                <div class="w-24 h-24 mx-auto rounded-full bg-gold-400/10 text-gold-400 flex items-center justify-center text-4xl border border-gold-400/30">
                    <i class="fa-regular fa-bookmark"></i>
                </div>

                <div class="space-y-2">
                    <h2 class="font-serif text-3xl text-white">No Reservations Yet</h2>
                    <p class="text-xs text-gray-400 max-w-md mx-auto leading-relaxed">
                        You have no active table reservations. Explore our Michelin-starred and fine dining collection to reserve your next culinary experience.
                    </p>
                </div>

                <div>
                    <a href="/restaurants" class="inline-block px-8 py-4 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                        Browse Restaurants
                    </a>
                </div>
            </div>

        <% } %>
    </main>

    <!-- FOOTER -->
    <footer class="bg-dark-900 border-t border-white/10 pt-20 pb-12 text-gray-400 w-full">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
                <!-- Brand Info -->
                <div class="space-y-4">
                    <a href="/" class="flex items-center space-x-3">
                        <span class="w-8 h-8 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 font-serif font-bold">O</span>
                        <span class="font-serif text-xl tracking-widest text-white font-semibold uppercase">Open<span class="text-gold-400">Dine</span></span>
                    </a>
                    <p class="text-xs text-gray-500 leading-relaxed">
                        The world’s premier table booking platform for Michelin-starred and luxury culinary establishments.
                    </p>
                </div>

                <!-- Navigation Links -->
                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Platform</h5>
                    <ul class="space-y-2.5 text-xs">
                        <li><a href="/discover" class="hover:text-gold-400 transition-colors">Discover</a></li>
                        <li><a href="/restaurants" class="hover:text-gold-400 transition-colors">Featured Destinations</a></li>
                        <li><a href="/cuisines" class="hover:text-gold-400 transition-colors">Cuisine Collections</a></li>
                        <li><a href="/private-dining" class="hover:text-gold-400 transition-colors">Private Events</a></li>
                    </ul>
                </div>

                <!-- Legal Links -->
                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Information</h5>
                    <ul class="space-y-2.5 text-xs">
                        <li><a href="/about" class="hover:text-gold-400 transition-colors">About Us</a></li>
                        <li><a href="/concierge" class="hover:text-gold-400 transition-colors">Concierge Services</a></li>
                        <li><a href="/terms" class="hover:text-gold-400 transition-colors">Terms of Service</a></li>
                        <li><a href="/privacy" class="hover:text-gold-400 transition-colors">Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Social & Contact -->
                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Connect</h5>
                    <div class="flex space-x-4 mb-4">
                        <a href="#" class="w-9 h-9 rounded-full bg-dark-800 border border-white/10 flex items-center justify-center text-gray-400 hover:text-gold-400 hover:border-gold-400 transition-all"><i class="fa-brands fa-instagram text-xs"></i></a>
                        <a href="#" class="w-9 h-9 rounded-full bg-dark-800 border border-white/10 flex items-center justify-center text-gray-400 hover:text-gold-400 hover:border-gold-400 transition-all"><i class="fa-brands fa-x-twitter text-xs"></i></a>
                        <a href="#" class="w-9 h-9 rounded-full bg-dark-800 border border-white/10 flex items-center justify-center text-gray-400 hover:text-gold-400 hover:border-gold-400 transition-all"><i class="fa-brands fa-linkedin-in text-xs"></i></a>
                    </div>
                    <p class="text-[10px] text-gray-500">Concierge Desk: concierge@opendine.com</p>
                </div>
            </div>

            <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between text-[11px] text-gray-500">
                <p>&copy; 2026 OpenDine Inc. All rights reserved.</p>
                <p class="mt-2 md:mt-0 uppercase tracking-widest text-[9px]">Crafted for Exceptional Taste</p>
            </div>
        </div>
    </footer>

    <!-- GSAP Animations & Vanilla JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        // 1. Sticky Navbar
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('glass-panel', 'py-4');
                navbar.classList.remove('py-6');
            } else {
                navbar.classList.remove('glass-panel', 'py-4');
                navbar.classList.add('py-6');
            }
        });

        // 2. User Menu Dropdown Toggle
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const dropdownArrow = document.getElementById('dropdown-arrow');

        if (userMenuBtn && userDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userDropdown.classList.contains('hidden');
                if (isHidden) {
                    userDropdown.classList.remove('hidden');
                    setTimeout(() => {
                        userDropdown.classList.remove('opacity-0', 'scale-95');
                        userDropdown.classList.add('opacity-100', 'scale-100');
                        if (dropdownArrow) dropdownArrow.classList.add('rotate-180');
                    }, 10);
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                    closeDropdown();
                }
            });

            function closeDropdown() {
                userDropdown.classList.remove('opacity-100', 'scale-100');
                userDropdown.classList.add('opacity-0', 'scale-95');
                if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
                setTimeout(() => userDropdown.classList.add('hidden'), 200);
            }
        }

        // 3. Confirmation Dialog for Cancelling
        function confirmCancellation(e) {
            const confirmed = confirm("Are you sure you wish to cancel this reservation? This action cannot be undone.");
            if (!confirmed) {
                e.preventDefault();
                return false;
            }
            return true;
        }

        // 4. GSAP Entrance Animations
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from('.header-anim', { opacity: 0, y: 30, duration: 1, ease: 'power3.out' });
            
            if (document.querySelector('.booking-card-anim')) {
                gsap.from('.booking-card-anim', {
                    opacity: 0,
                    y: 30,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: 'power3.out',
                    delay: 0.2
                });
            }

            if (document.querySelector('.empty-state-anim')) {
                gsap.from('.empty-state-anim', { opacity: 0, scale: 0.95, duration: 1, ease: 'power3.out', delay: 0.2 });
            }
        });
    </script>
</body>
</html>
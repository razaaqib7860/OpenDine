<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.statusCode || 500 %> — <%= locals.title || 'System Exception' %> | OpenDine</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .glass-panel {
            background: rgba(18, 20, 24, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.25);
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Floating Glow Spheres */
        .ambient-sphere {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            opacity: 0.15;
            animation: float 10s ease-in-out infinite alternate;
        }

        @keyframes float {
            0% { transform: translateY(0px) scale(1); }
            100% { transform: translateY(-30px) scale(1.1); }
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black min-h-screen flex flex-col justify-between relative">

    <!-- Ambient Glowing Orbs -->
    <div class="ambient-sphere w-96 h-96 bg-gold-400 top-10 left-1/4"></div>
    <div class="ambient-sphere w-80 h-80 bg-gold-600 bottom-20 right-1/4" style="animation-delay: -5s;"></div>

    <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 py-6 border-b border-white/5 transition-all">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-3 group">
                <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 font-serif font-bold group-hover:border-gold-400 transition-colors">
                    O
                </span>
                <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                    Open<span class="text-gold-400">Dine</span>
                </span>
            </a>

            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold border-l border-white/10 pl-6 hidden sm:inline">
                Concierge Exception
            </span>
        </div>
    </header>

    <% 
        // Fallback Default Values
        const code = locals.statusCode || 500;
        const errTitle = locals.title || 'Unanticipated System Interruption';
        const errMessage = locals.message || 'Our concierge servers encountered an unexpected condition. Please return home or retry your request.';
        const userObj = locals.user || null;

        // Dynamic Icon Logic per HTTP Status
        let iconClass = 'fa-compass-slash';
        if (code === 404) iconClass = 'fa-compass-slash';
        else if (code === 403) iconClass = 'fa-user-shield';
        else if (code === 401) iconClass = 'fa-key';
        else if (code === 500) iconClass = 'fa-server';
        else if (code === 503) iconClass = 'fa-hourglass-half';
    %>

    <!-- ERROR MAIN CONTAINER -->
    <main class="pt-32 pb-20 px-6 lg:px-12 max-w-3xl mx-auto w-full flex-grow flex items-center justify-center relative z-10">
        <div class="glass-panel p-8 sm:p-14 rounded-3xl border border-gold-400/30 shadow-2xl text-center space-y-8 error-card-anim w-full relative overflow-hidden">
            
            <!-- Floating Top Badge -->
            <span class="inline-block text-[11px] uppercase tracking-[0.3em] text-gold-400 font-semibold px-4 py-1.5 rounded-full border border-gold-400/30 bg-gold-400/10">
                HTTP Exception <%= code %>
            </span>

            <!-- Large Status Code & Icon -->
            <div class="relative space-y-2">
                <h1 class="font-serif text-7xl sm:text-9xl font-normal tracking-tight text-white/10 select-none">
                    <%= code %>
                </h1>
                
                <div class="w-20 h-20 mx-auto rounded-full bg-gold-400/10 border border-gold-400/40 flex items-center justify-center text-gold-400 text-3xl shadow-xl shadow-gold-500/10 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
                    <i class="fa-solid <%= iconClass %>"></i>
                </div>
            </div>

            <!-- Heading & Meaningful Description -->
            <div class="space-y-3 max-w-xl mx-auto">
                <h2 class="font-serif text-2xl sm:text-4xl text-white font-normal leading-tight">
                    <%= errTitle %>
                </h2>
                <p class="text-xs sm:text-sm text-gray-400 leading-relaxed font-light">
                    <%= errMessage %>
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
                <!-- Return Home Button -->
                <a href="/" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                    <i class="fa-solid fa-house mr-2"></i> Return Home
                </a>

                <!-- Go Back Button -->
                <button onclick="window.history.back()" class="px-8 py-3.5 rounded-full border border-white/10 text-gray-300 hover:border-gold-400 hover:text-gold-400 font-semibold text-xs uppercase tracking-widest transition-all">
                    <i class="fa-solid fa-arrow-left mr-2"></i> Go Back
                </button>

                <!-- Conditional Role Dashboard Button -->
                <% if (userObj) { %>
                    <% if (userObj.role === 'admin') { %>
                        <a href="/admin/dashboard" class="px-8 py-3.5 rounded-full glass-panel border border-gold-400/40 text-gold-400 font-semibold text-xs uppercase tracking-widest hover:bg-gold-400 hover:text-black transition-all">
                            <i class="fa-solid fa-shield-halved mr-2"></i> Admin Portal
                        </a>
                    <% } else if (userObj.role === 'owner') { %>
                        <a href="/owner/dashboard" class="px-8 py-3.5 rounded-full glass-panel border border-gold-400/40 text-gold-400 font-semibold text-xs uppercase tracking-widest hover:bg-gold-400 hover:text-black transition-all">
                            <i class="fa-solid fa-utensils mr-2"></i> Owner Dashboard
                        </a>
                    <% } else { %>
                        <a href="/bookings/myBookings" class="px-8 py-3.5 rounded-full glass-panel border border-gold-400/40 text-gold-400 font-semibold text-xs uppercase tracking-widest hover:bg-gold-400 hover:text-black transition-all">
                            <i class="fa-regular fa-bookmark mr-2"></i> My Bookings
                        </a>
                    <% } %>
                <% } %>
            </div>

            <div class="pt-6 border-t border-white/5 text-[10px] text-gray-500 tracking-wider uppercase">
                OpenDine Hospitality Concierge • Reference ID: <span class="font-mono text-gold-400/70">ERR-<%= Math.floor(100000 + Math.random() * 900000) %></span>
            </div>

        </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-dark-900 border-t border-white/10 pt-12 pb-8 text-gray-400 w-full relative z-10">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col md:flex-row items-center justify-between text-[11px] text-gray-500">
            <a href="/" class="flex items-center space-x-3 mb-4 md:mb-0">
                <span class="w-6 h-6 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 font-serif text-xs font-bold">O</span>
                <span class="font-serif text-sm tracking-widest text-white font-semibold uppercase">Open<span class="text-gold-400">Dine</span></span>
            </a>
            <p>&copy; 2026 OpenDine Inc. All rights reserved.</p>
            <p class="mt-2 md:mt-0 uppercase tracking-widest text-[9px]">Systems Operational</p>
        </div>
    </footer>

    <!-- GSAP Entrance Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from('.error-card-anim', {
                opacity: 0,
                scale: 0.92,
                y: 30,
                duration: 1,
                ease: 'power3.out'
            });
        });
    </script>
</body>
</html>
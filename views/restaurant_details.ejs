    <!-- Swiper JS & GSAP -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

    <script>
        // 1. Sticky Navbar
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('glass-panel', 'py-4');
                navbar.classList.remove('py-6');
            } else {
                navbar.classList.remove('glass-panel', 'py-4');
                navbar.classList.add('py-6');
            }
        });

        // 2. User Menu Dropdown Toggle
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const dropdownArrow = document.getElementById('dropdown-arrow');

        if (userMenuBtn && userDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userDropdown.classList.contains('hidden');
                if (isHidden) {
                    userDropdown.classList.remove('hidden');
                    setTimeout(() => {
                        userDropdown.classList.remove('opacity-0', 'scale-95');
                        userDropdown.classList.add('opacity-100', 'scale-100');
                        if (dropdownArrow) dropdownArrow.classList.add('rotate-180');
                    }, 10);
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                    closeDropdown();
                }
            });

            function closeDropdown() {
                userDropdown.classList.remove('opacity-100', 'scale-100');
                userDropdown.classList.add('opacity-0', 'scale-95');
                if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
                setTimeout(() => userDropdown.classList.add('hidden'), 200);
            }
        }

        // 3. Swiper Gallery Initialization
        if (document.querySelector('.gallerySwiper')) {
            new Swiper('.gallerySwiper', {
                loop: true,
                autoplay: { delay: 4000, disableOnInteraction: false },
                navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
                pagination: { el: '.swiper-pagination', clickable: true },
            });
        }

        // 4. Set Default Date to Today
        const dateInput = document.getElementById('booking-date');
        if (dateInput) {
            const today = new Date().toISOString().split('T')[0];
            dateInput.value = today;
            dateInput.min = today;
        }

        // 5. Time Slot Selection Logic
        const slotBtns = document.querySelectorAll('.slot-btn');
        const selectedTimeInput = document.getElementById('selected-time');

        slotBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                slotBtns.forEach(b => {
                    if(!b.disabled) {
                        b.classList.remove('bg-gold-400', 'text-black', 'border-gold-400');
                        b.classList.add('bg-dark-900', 'text-gray-200', 'border-white/10');
                    }
                });
                btn.classList.remove('bg-dark-900', 'text-gray-200', 'border-white/10');
                btn.classList.add('bg-gold-400', 'text-black', 'border-gold-400');
                selectedTimeInput.value = btn.getAttribute('data-time');
            });
        });

        // 6. Reservation Button Click & Drawer Trigger
        const bookNowBtn = document.getElementById('book-now-btn');
        const drawerOverlay = document.getElementById('booking-drawer-overlay');
        const drawer = document.getElementById('booking-drawer');
        const closeDrawerBtn = document.getElementById('close-drawer-btn');
        const isLoggedIn = <%= Boolean(locals.user) %>;

        bookNowBtn.addEventListener('click', () => {
            const date = dateInput.value;
            const time = selectedTimeInput.value;
            const guests = document.getElementById('booking-guests').value;

            if (!date) {
                alert('Please select a reservation date.');
                return;
            }
            if (!time) {
                alert('Please choose an available time slot.');
                return;
            }

            // Check Authentication State
            if (!isLoggedIn) {
                const currentSlug = "<%= restaurant.slug %>";
                window.location.href = `/user/login?redirect=/restaurants/${currentSlug}`;
                return;
            }

            // Populate Drawer Summary Fields
            document.getElementById('summary-date').textContent = date;
            document.getElementById('summary-time').textContent = time;
            document.getElementById('summary-guests').textContent = `${guests} Guest(s)`;

            document.getElementById('drawer-input-date').value = date;
            document.getElementById('drawer-input-time').value = time;
            document.getElementById('drawer-input-guests').value = guests;

            // Open Drawer
            drawerOverlay.classList.remove('hidden');
            setTimeout(() => {
                drawerOverlay.classList.remove('opacity-0');
                drawer.classList.remove('translate-x-full');
            }, 10);
        });

        function closeDrawer() {
            drawer.classList.add('translate-x-full');
            drawerOverlay.classList.add('opacity-0');
            setTimeout(() => {
                drawerOverlay.classList.add('hidden');
            }, 300);
        }

        if (closeDrawerBtn) closeDrawerBtn.addEventListener('click', closeDrawer);
        if (drawerOverlay) {
            drawerOverlay.addEventListener('click', (e) => {
                if (e.target === drawerOverlay) closeDrawer();
            });
        }

        // Sync Notes Textarea with Hidden Input
        const specialRequests = document.getElementById('special-requests');
        const drawerNotes = document.getElementById('drawer-input-notes');
        if (specialRequests && drawerNotes) {
            specialRequests.addEventListener('input', (e) => {
                drawerNotes.value = e.target.value;
            });
        }

        // 7. Handle Booking Submission via Fetch API (No Page Reload)
        const drawerBookingForm = document.getElementById('drawer-booking-form');
        if (drawerBookingForm) {
            drawerBookingForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const formData = new FormData(drawerBookingForm);
                const payload = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch(drawerBookingForm.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });

                    if (response.ok) {
                        const result = await response.json();
                        closeDrawer();
                        
                        const bookingData = result.booking || {
                            _id: result._id || result.id || 'OD-' + Math.floor(100000 + Math.random() * 900000),
                            restaurant: { name: "<%= restaurant.name %>" },
                            date: payload.date,
                            time: payload.time,
                            guests: payload.guests,
                            status: 'Confirmed',
                            createdAt: new Date().toISOString()
                        };

                        if (typeof window.openBookingSuccessModal === 'function') {
                            window.openBookingSuccessModal(bookingData);
                        }
                    } else {
                        const errorData = await response.json().catch(() => ({}));
                        alert(errorData.message || 'Error processing reservation. Please try again.');
                    }
                } catch (err) {
                    console.error('Reservation submit error:', err);
                    alert('Server connection error. Please try again.');
                }
            });
        }
    </script>
</body>
</html>
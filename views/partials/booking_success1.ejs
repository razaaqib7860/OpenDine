<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservation Confirmed — OpenDine Concierge</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Backdrop Blur Glassmorphism */
        .glass-panel {
            background: rgba(18, 20, 24, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.25);
        }

        /* Gold Gradient Text */
        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Printable Ticket Dashed Cutout Effect */
        .ticket-edge {
            position: relative;
        }
        .ticket-edge::before, .ticket-edge::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 20px;
            height: 20px;
            background-color: #0B0C0E;
            border-radius: 50%;
            transform: translateY(-50%);
        }
        .ticket-edge::before { left: -10px; border-right: 1px solid rgba(212, 175, 55, 0.25); }
        .ticket-edge::after { right: -10px; border-left: 1px solid rgba(212, 175, 55, 0.25); }

        /* Print Mode Adjustments */
        @media print {
            header, footer, .no-print {
                display: none !important;
            }
            body {
                background: #fff !important;
                color: #000 !important;
            }
            .glass-panel {
                background: #fff !important;
                border: 2px solid #000 !important;
                color: #000 !important;
                box-shadow: none !important;
            }
            .gold-gradient-text, .text-white, .text-gold-400 {
                color: #000 !important;
                -webkit-text-fill-color: #000 !important;
            }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black min-h-screen flex flex-col justify-between">

    <!-- NAVBAR (Matches Platform Theme) -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            <div class="flex items-center space-x-12">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>

                <nav class="hidden md:flex items-center space-x-8 text-xs font-medium uppercase tracking-widest">
                    <a href="/discover" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Discover</a>
                    <a href="/restaurants" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Restaurants</a>
                    <a href="/bookings/myBookings" class="text-gold-400 font-semibold transition-colors duration-300">My Bookings</a>
                </nav>
            </div>

            <div class="flex items-center space-x-6">
                <% if(locals.user) { %>
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <img src="<%= user.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150' %>" 
                                 alt="<%= user.Name %>" 
                                 class="w-8 h-8 rounded-full object-cover border border-gold-400/50">
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors">
                                <%= user.Name %>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>

                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user.email %></p>
                            </div>

                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-user w-5"></i> Profile
                            </a>
                            <a href="/bookings/myBookings" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors">
                                <i class="fa-regular fa-bookmark w-5"></i> My Bookings
                            </a>

                            <% if(user.role === 'owner') { %>
                                <a href="/owner/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-utensils w-5"></i> Owner Dashboard
                                </a>
                            <% } %>

                            <% if(user.role === 'admin') { %>
                                <a href="/admin/dashboard" class="flex items-center px-4 py-2.5 text-xs text-gold-400 hover:bg-gold-400/10 transition-colors border-t border-white/5">
                                    <i class="fa-solid fa-shield-halved w-5"></i> Admin Dashboard
                                </a>
                            <% } %>

                            <div class="border-t border-white/10 mt-1"></div>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors">
                                <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/user/login" class="text-xs font-semibold uppercase tracking-widest text-white hover:text-gold-400 transition-colors">Log In</a>
                    <a href="/user/signup" class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-gold-500 to-gold-400 text-black hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                        Sign Up
                    </a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- CONFIRMATION CONTENT -->
    <main class="pt-32 pb-20 px-6 lg:px-12 max-w-4xl mx-auto w-full flex-grow">
        
        <!-- SUCCESS HEADER -->
        <div class="text-center space-y-4 mb-12 success-header-anim">
            <div class="w-20 h-20 mx-auto rounded-full bg-gold-400/10 border border-gold-400/40 flex items-center justify-center text-gold-400 text-3xl shadow-xl shadow-gold-500/10">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            
            <span class="inline-block text-[11px] uppercase tracking-[0.3em] text-gold-400 font-semibold px-4 py-1.5 rounded-full border border-gold-400/30 glass-panel">
                Concierge Confirmation Pass
            </span>

            <h1 class="font-serif text-4xl sm:text-5xl font-normal text-white">
                RESERVATION <span class="italic font-light text-[#C8A04A]">CONFIRMED</span>
            </h1>

            <p class="text-xs sm:text-sm text-gray-400 max-w-md mx-auto leading-relaxed">
                Your table has been successfully reserved. A formal itinerary has been routed to your registered email address.
            </p>
        </div>

        <!-- LUXURY BOOKING PASS TICKET CARD -->
        <div class="glass-panel rounded-3xl border border-gold-400/30 shadow-2xl overflow-hidden success-card-anim relative">
            
            <!-- Top Banner -->
            <div class="bg-gradient-to-r from-dark-800 via-dark-700 to-dark-800 px-8 py-5 border-b border-white/10 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <span class="w-7 h-7 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-900 text-gold-400 font-serif text-xs font-bold">O</span>
                    <span class="text-xs uppercase tracking-widest text-white font-semibold">OpenDine Concierge</span>
                </div>
                <div class="flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-[10px] uppercase tracking-widest text-emerald-400 font-semibold">
                        <%= booking.status || 'Confirmed' %>
                    </span>
                </div>
            </div>

            <!-- Main Pass Details -->
            <div class="p-8 space-y-8">
                
                <!-- Restaurant Header -->
                <div class="flex flex-col sm:flex-row items-center gap-6 border-b border-white/10 pb-8">
                    <img src="<%= (booking.restaurant && booking.restaurant.images && booking.restaurant.images.length > 0) ? booking.restaurant.images[0] : 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=600' %>" 
                         alt="<%= booking.restaurant ? booking.restaurant.name : 'Restaurant' %>" 
                         class="w-28 h-28 rounded-2xl object-cover border border-gold-400/30 shadow-lg flex-shrink-0">
                    
                    <div class="text-center sm:text-left space-y-2 flex-grow">
                        <span class="text-[10px] uppercase tracking-widest text-gold-400 font-semibold">
                            <%= booking.restaurant ? (booking.restaurant.cuisine || 'Fine Dining') : 'Fine Dining' %> • Avg ₹<%= booking.restaurant ? (booking.restaurant.priceRange || '1000') : '1000' %> • 2 Guests
                        </span>
                        <h2 class="font-serif text-3xl text-white">
                            <%= booking.restaurant ? booking.restaurant.name : 'Exclusive Establishment' %>
                        </h2>
                        <p class="text-xs text-gray-400 flex items-center justify-center sm:justify-start">
                            <i class="fa-solid fa-location-dot text-gold-400 mr-2"></i>
                            <%= booking.restaurant ? (booking.restaurant.location + ' — ' + (booking.restaurant.address || '')) : 'Luxury Location' %>
                        </p>
                    </div>
                </div>

                <!-- Reservation Specifications Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 bg-dark-900/60 p-6 rounded-2xl border border-white/5">
                    <div>
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 block">Date</span>
                        <span class="text-sm text-white font-semibold mt-1 flex items-center">
                            <i class="fa-regular fa-calendar text-gold-400 mr-2"></i> <%= booking.date %>
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 block">Time</span>
                        <span class="text-sm text-gold-400 font-semibold mt-1 flex items-center">
                            <i class="fa-regular fa-clock text-gold-400 mr-2"></i> <%= booking.time %>
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 block">Guests</span>
                        <span class="text-sm text-white font-semibold mt-1 flex items-center">
                            <i class="fa-solid fa-user-group text-gold-400 mr-2"></i> <%= booking.guests %> <%= booking.guests == 1 ? 'Guest' : 'Guests' %>
                        </span>
                    </div>

                    <div>
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 block">Booking ID</span>
                        <span class="text-xs font-mono text-gray-300 mt-1 block truncate">
                            #<%= booking._id.toString().toUpperCase() %>
                        </span>
                    </div>
                </div>

                <!-- Custom Preferences & Timestamp -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-gray-400">
                    <div class="space-y-2">
                        <p><span class="text-gold-400 font-medium uppercase tracking-wider text-[10px] block mb-1">Occasion</span> <%= booking.occasion || 'Casual Fine Dining' %></p>
                        <p><span class="text-gold-400 font-medium uppercase tracking-wider text-[10px] block mb-1">Special Instructions</span> "<%= booking.specialRequests || 'None requested.' %>"</p>
                    </div>

                    <div class="space-y-2 md:text-right border-t md:border-t-0 md:border-l border-white/10 pt-4 md:pt-0 md:pl-6">
                        <% if(booking.restaurant && booking.restaurant.chef) { %>
                            <p><span class="text-gold-400 font-medium uppercase tracking-wider text-[10px] block mb-1">Executive Chef</span> <%= booking.restaurant.chef %></p>
                        <% } %>
                        <p><span class="text-gray-500 font-medium uppercase tracking-wider text-[10px] block mb-1">Reserved On</span> <%= new Date(booking.createdAt || Date.now()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                    </div>
                </div>

            </div>

            <!-- Ticket Cutout Separator -->
            <div class="ticket-edge border-t border-dashed border-white/20 my-2"></div>

            <!-- Pass Footer / Barcode Placeholder -->
            <div class="p-6 bg-dark-900/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
                <div class="space-y-1">
                    <p class="text-xs font-semibold text-white">Present this pass upon arrival</p>
                    <p class="text-[10px] text-gray-500">Host desk hold extended for 15 minutes past reserved time.</p>
                </div>
                <div class="font-mono text-xs tracking-widest text-gold-400/80 bg-black/40 px-4 py-2 rounded-lg border border-gold-400/20">
                    OPENDINE-<%= booking._id.toString().slice(-6).toUpperCase() %>
                </div>
            </div>

        </div>

        <!-- ACTION BUTTONS -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 no-print success-actions-anim">
            <a href="/bookings/myBookings" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">
                View My Bookings
            </a>

            <% if(booking.restaurant && booking.restaurant.slug) { %>
                <a href="/restaurants/<%= booking.restaurant.slug %>" class="px-8 py-3.5 rounded-full glass-panel border border-gold-400/40 text-gold-400 font-semibold text-xs uppercase tracking-widest hover:bg-gold-400 hover:text-black transition-all duration-300">
                    View Restaurant
                </a>
            <% } %>

            <a href="/restaurants" class="px-8 py-3.5 rounded-full border border-white/10 text-gray-300 hover:border-gold-400 hover:text-gold-400 font-semibold text-xs uppercase tracking-widest transition-all">
                Browse Restaurants
            </a>

            <button onclick="window.print()" class="px-8 py-3.5 rounded-full border border-white/10 text-gray-400 hover:border-white hover:text-white font-semibold text-xs uppercase tracking-widest transition-all">
                <i class="fa-solid fa-print mr-2"></i> Print Pass
            </button>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="bg-dark-900 border-t border-white/10 pt-16 pb-12 text-gray-400 w-full no-print">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="flex flex-col md:flex-row items-center justify-between text-[11px] text-gray-500 border-t border-white/5 pt-8">
                <a href="/" class="flex items-center space-x-3 mb-4 md:mb-0">
                    <span class="w-6 h-6 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 font-serif text-xs font-bold">O</span>
                    <span class="font-serif text-sm tracking-widest text-white font-semibold uppercase">Open<span class="text-gold-400">Dine</span></span>
                </a>
                <p>&copy; 2026 OpenDine Inc. All rights reserved.</p>
                <p class="mt-2 md:mt-0 uppercase tracking-widest text-[9px]">Crafted for Exceptional Taste</p>
            </div>
        </div>
    </footer>

    <!-- GSAP Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        // 1. Sticky Navbar
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('glass-panel', 'py-4');
                navbar.classList.remove('py-6');
            } else {
                navbar.classList.remove('glass-panel', 'py-4');
                navbar.classList.add('py-6');
            }
        });

        // 2. User Dropdown Toggle
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const dropdownArrow = document.getElementById('dropdown-arrow');

        if (userMenuBtn && userDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userDropdown.classList.contains('hidden');
                if (isHidden) {
                    userDropdown.classList.remove('hidden');
                    setTimeout(() => {
                        userDropdown.classList.remove('opacity-0', 'scale-95');
                        userDropdown.classList.add('opacity-100', 'scale-100');
                        if (dropdownArrow) dropdownArrow.classList.add('rotate-180');
                    }, 10);
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                    closeDropdown();
                }
            });

            function closeDropdown() {
                userDropdown.classList.remove('opacity-100', 'scale-100');
                userDropdown.classList.add('opacity-0', 'scale-95');
                if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
                setTimeout(() => userDropdown.classList.add('hidden'), 200);
            }
        }

        // 3. GSAP Entrance Animations
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from('.success-header-anim', { opacity: 0, y: 30, duration: 1, ease: 'power3.out' });
            gsap.from('.success-card-anim', { opacity: 0, scale: 0.95, duration: 1, ease: 'power3.out', delay: 0.2 });
            gsap.from('.success-actions-anim', { opacity: 0, y: 20, duration: 0.8, ease: 'power3.out', delay: 0.4 });
        });
    </script>
</body>
</html>
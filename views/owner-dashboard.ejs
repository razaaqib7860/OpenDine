<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Owner Dashboard — <%= restaurant ? restaurant.name : 'OpenDine Establishment' %></title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .glass-panel {
            background: rgba(18, 20, 24, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black">

    <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-4 glass-panel border-b border-white/10">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            <div class="flex items-center space-x-8">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>
                <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold hidden md:inline-block border-l border-white/10 pl-6">
                    Concierge Portal
                </span>
            </div>

            <div class="flex items-center space-x-6">
                <a href="/owner/dashboard" class="text-xs font-semibold uppercase tracking-widest text-gold-400">Dashboard</a>
                <a href="/owner/stats" class="text-xs font-semibold uppercase tracking-widest text-gray-400 hover:text-white transition-colors">Analytics</a>
                
                <% if (locals.user) { %>
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <img src="<%= user.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150' %>" 
                                 alt="<%= user.Name %>" 
                                 class="w-8 h-8 rounded-full object-cover border border-gold-400/50">
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors">
                                <%= user.Name %>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>

                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as Owner</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user.email %></p>
                            </div>
                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors">
                                <i class="fa-regular fa-user w-5"></i> Profile
                            </a>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors border-t border-white/10">
                                <i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </header>

    <div class="pt-24 pb-20 max-w-7xl mx-auto px-6 lg:px-12 space-y-16">

        <% if (locals.restaurant) { %>
            
            <!-- SECTION 1: LUXURY HERO -->
            <section class="relative rounded-3xl overflow-hidden glass-panel border border-gold-400/30 hero-anim shadow-2xl">
                <!-- Cover Image Background -->
                <div class="relative h-80 sm:h-96 w-full overflow-hidden">
                    <img src="<%= (restaurant.images && restaurant.images.length > 0) ? restaurant.images[0] : 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=2000' %>" 
                         alt="<%= restaurant.name %>" 
                         class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/60 to-transparent"></div>
                    
                    <!-- Floating Flags & Status Badges -->
                    <div class="absolute top-6 left-6 flex flex-wrap gap-2">
                        <% if (restaurant.status === 'approved') { %>
                            <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-widest bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-semibold backdrop-blur-md">
                                <i class="fa-solid fa-shield-check mr-1.5"></i> Approved
                            </span>
                        <% } else if (restaurant.status === 'rejected') { %>
                            <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-widest bg-red-500/20 text-red-400 border border-red-500/40 font-semibold backdrop-blur-md">
                                <i class="fa-solid fa-triangle-exclamation mr-1.5"></i> Rejected
                            </span>
                        <% } else { %>
                            <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-widest bg-amber-500/20 text-amber-400 border border-amber-500/40 font-semibold backdrop-blur-md">
                                <i class="fa-solid fa-hourglass-half mr-1.5"></i> Pending Approval
                            </span>
                        <% } %>

                        <% if (restaurant.exclusive) { %>
                            <span class="px-3.5 py-1.5 rounded-full text-[10px] uppercase tracking-widest bg-gold-400/20 text-gold-400 border border-gold-400/40 font-semibold backdrop-blur-md">
                                <i class="fa-solid fa-crown mr-1.5"></i> Exclusive
                            </span>
                        <% } %>
                    </div>
                </div>

                <!-- Content Overlay -->
                <div class="p-8 sm:p-10 -mt-24 relative z-10 space-y-6">
                    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
                        <div class="space-y-3">
                            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">
                                <%= restaurant.cuisine || 'Fine Dining' %> • <%= restaurant.priceRange || '$$$$' %>
                            </span>
                            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-white font-normal">
                                <%= restaurant.name %>
                            </h1>
                            
                            <div class="flex flex-wrap items-center gap-4 text-xs text-gray-300 pt-1">
                                <% if (restaurant.chef) { %>
                                    <span class="flex items-center text-gold-300 font-medium">
                                        <i class="fa-solid fa-hat-chef text-gold-400 mr-2"></i> Executive Chef <%= restaurant.chef %>
                                    </span>
                                    <span class="text-gray-600">•</span>
                                <% } %>
                                <span class="flex items-center">
                                    <i class="fa-solid fa-location-dot text-gold-400 mr-2"></i> <%= restaurant.location || restaurant.address %>
                                </span>
                                <span class="text-gray-600">•</span>
                                <span class="flex items-center">
                                    <i class="fa-regular fa-clock text-gold-400 mr-2"></i> <%= restaurant.openingTime || '17:00' %> – <%= restaurant.closingTime || '23:00' %>
                                </span>
                                <span class="text-gray-600">•</span>
                                <span class="flex items-center text-gold-400 font-semibold">
                                    <i class="fa-solid fa-star mr-1"></i> <%= restaurant.averageRating || '4.9' %> (<%= restaurant.totalReviews || '0' %>)
                                </span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex items-center gap-3 flex-shrink-0">
                            <a href="#edit-section" class="px-6 py-3.5 rounded-full border border-gold-400/40 text-gold-400 hover:bg-gold-400 hover:text-black font-semibold text-xs uppercase tracking-widest transition-all">
                                <i class="fa-solid fa-pen-to-square mr-2"></i> Edit Details
                            </a>
                            <a href="/restaurants/<%= restaurant.slug %>" target="_blank" class="px-6 py-3.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all shadow-lg shadow-gold-500/20">
                                <i class="fa-solid fa-arrow-up-right-from-square mr-2"></i> View Live Page
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION 4: RESTAURANT STATISTICS -->
            <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% 
                    const totalBookings = ownerBookings ? ownerBookings.length : 0;
                    const confirmedBookings = ownerBookings ? ownerBookings.filter(b => b.status === 'confirmed').length : 0;
                    const todayStr = new Date().toISOString().split('T')[0];
                    const todayBookings = ownerBookings ? ownerBookings.filter(b => b.date === todayStr).length : 0;
                    
                    let totalGuests = 0;
                    if (ownerBookings && ownerBookings.length > 0) {
                        ownerBookings.forEach(b => { totalGuests += (parseInt(b.guests) || 1); });
                    }
                    const avgGuests = totalBookings > 0 ? (totalGuests / totalBookings).toFixed(1) : '0';
                    const estimatedRevenue = totalGuests * 125; // Estimate based on guest count
                %>

                <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-2">
                    <div class="flex items-center justify-between text-gold-400">
                        <span class="text-xs uppercase tracking-widest text-gray-400 font-semibold">Today's Bookings</span>
                        <i class="fa-regular fa-calendar-check text-xl"></i>
                    </div>
                    <p class="font-serif text-3xl text-white font-bold"><%= todayBookings %></p>
                    <p class="text-[10px] text-gray-500">Scheduled for today's service</p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-2">
                    <div class="flex items-center justify-between text-gold-400">
                        <span class="text-xs uppercase tracking-widest text-gray-400 font-semibold">Confirmed Reservations</span>
                        <i class="fa-solid fa-clipboard-check text-xl"></i>
                    </div>
                    <p class="font-serif text-3xl text-white font-bold"><%= confirmedBookings %></p>
                    <p class="text-[10px] text-gray-500"><%= totalBookings %> total lifetime requests</p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-2">
                    <div class="flex items-center justify-between text-gold-400">
                        <span class="text-xs uppercase tracking-widest text-gray-400 font-semibold">Average Party Size</span>
                        <i class="fa-solid fa-users text-xl"></i>
                    </div>
                    <p class="font-serif text-3xl text-white font-bold"><%= avgGuests %></p>
                    <p class="text-[10px] text-gray-500">Guests per table reservation</p>
                </div>

                <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-2">
                    <div class="flex items-center justify-between text-gold-400">
                        <span class="text-xs uppercase tracking-widest text-gray-400 font-semibold">Est. Deposit Revenue</span>
                        <i class="fa-solid fa-vault text-xl"></i>
                    </div>
                    <p class="font-serif text-3xl text-gold-400 font-bold">$<%= estimatedRevenue.toLocaleString() %></p>
                    <p class="text-[10px] text-gray-500">Based on guest headcount</p>
                </div>
            </section>

            <!-- SECTION 2: RESTAURANT GALLERY -->
            <section class="space-y-6">
                <div class="flex items-center justify-between border-b border-white/10 pb-4">
                    <div>
                        <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Media Portfolio</span>
                        <h2 class="font-serif text-2xl text-white mt-1">Restaurant Gallery</h2>
                    </div>
                    <span class="text-xs text-gray-400"><%= (restaurant.images) ? restaurant.images.length : 0 %> Media Assets</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <% if (restaurant.images && restaurant.images.length > 0) { %>
                        <% restaurant.images.forEach((img, idx) => { %>
                            <div class="relative group rounded-2xl overflow-hidden border border-white/10 h-48 bg-dark-800">
                                <img src="<%= img %>" alt="Gallery Image <%= idx + 1 %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                <div class="absolute inset-0 bg-dark-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center space-x-3">
                                    <a href="<%= img %>" target="_blank" class="w-9 h-9 rounded-full bg-dark-900/80 text-gold-400 border border-gold-400/40 flex items-center justify-center hover:bg-gold-400 hover:text-black transition-colors">
                                        <i class="fa-solid fa-expand text-xs"></i>
                                    </a>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-span-full py-12 glass-panel text-center rounded-2xl text-gray-500 font-serif">
                            No gallery images uploaded. Add image URLs in the configuration card.
                        </div>
                    <% } %>
                </div>
            </section>

            <!-- SECTION 3: RESERVATION MANAGEMENT TABLE -->
            <section class="space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/10 pb-4">
                    <div>
                        <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Guest Ledger</span>
                        <h2 class="font-serif text-2xl text-white mt-1">Reservation Management</h2>
                    </div>

                    <!-- Search & Filter Controls -->
                    <div class="flex flex-wrap items-center gap-3">
                        <input type="text" id="booking-search" placeholder="Search guest, email, phone..." 
                               class="bg-dark-800 border border-white/10 text-xs text-white rounded-full px-4 py-2.5 focus:outline-none focus:border-gold-400 w-full sm:w-64 placeholder-gray-500">
                        
                        <select id="booking-filter-status" class="bg-dark-800 border border-white/10 text-xs text-white rounded-full px-4 py-2.5 focus:outline-none focus:border-gold-400 cursor-pointer">
                            <option value="all">All Statuses</option>
                            <option value="confirmed">Confirmed</option>
                            <option value="completed">Completed</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>

                <div class="glass-panel rounded-3xl overflow-hidden border border-white/10">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-gray-300">
                            <thead class="bg-dark-800/80 text-gold-400 uppercase tracking-widest text-[10px] border-b border-white/10">
                                <tr>
                                    <th class="p-4 pl-6">Guest Info</th>
                                    <th class="p-4">Date & Time</th>
                                    <th class="p-4">Party Size</th>
                                    <th class="p-4">Occasion & Notes</th>
                                    <th class="p-4">Status</th>
                                    <th class="p-4 pr-6 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-white/5" id="booking-table-body">
                                <% if (ownerBookings && ownerBookings.length > 0) { %>
                                    <% ownerBookings.forEach(booking => { %>
                                        <tr class="hover:bg-white/[0.02] transition-colors booking-row" 
                                        <% console.log(booking.user); %>
data-guest="<%= booking.user %>"
                                            data-status="<%= (booking.status || 'confirmed').toLowerCase() %>">
                                            
                                            <td class="p-4 pl-6">
                                                <p class="font-semibold text-white text-sm"><%= booking.user ? booking.user.name : 'Valued Patron' %></p>
                                                <p class="text-[11px] text-gray-400"><%= booking.user ? booking.user.email : 'N/A' %></p>
                                                <p class="text-[10px] text-gold-400/80 mt-0.5"><i class="fa-solid fa-phone text-[9px] mr-1"></i> <%= booking.phone || 'No Phone' %></p>
                                            </td>

                                            <td class="p-4">
                                                <p class="text-white font-medium"><%= booking.date %></p>
                                                <p class="text-gold-400 font-semibold mt-0.5"><i class="fa-regular fa-clock text-[10px] mr-1"></i> <%= booking.time %></p>
                                            </td>

                                            <td class="p-4 font-semibold text-white">
                                                <span class="px-2.5 py-1 rounded-full bg-dark-800 border border-white/10">
                                                    <i class="fa-solid fa-user-group text-gold-400 text-[10px] mr-1"></i> <%= booking.guests %>
                                                </span>
                                            </td>

                                            <td class="p-4 max-w-xs">
                                                <% if (booking.occasion) { %>
                                                    <span class="text-[10px] uppercase tracking-wider text-gold-300 block font-semibold"><%= booking.occasion %></span>
                                                <% } %>
                                                <p class="text-gray-400 text-[11px] truncate" title="<%= booking.specialRequests %>">
                                                    <%= booking.specialRequests ? `"${booking.specialRequests}"` : 'No special requests' %>
                                                </p>
                                            </td>

                                            <td class="p-4">
                                                <% if (booking.status === 'completed') { %>
                                                    <span class="px-3 py-1 rounded-full text-[10px] uppercase tracking-wider bg-gold-400/20 text-gold-400 border border-gold-400/40 font-semibold">
                                                        Completed
                                                    </span>
                                                <% } else if (booking.status === 'cancelled') { %>
                                                    <span class="px-3 py-1 rounded-full text-[10px] uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/40 font-semibold">
                                                        Cancelled
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-3 py-1 rounded-full text-[10px] uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-semibold">
                                                        Confirmed
                                                    </span>
                                                <% } %>
                                            </td>

                                            <td class="p-4 pr-6 text-right">
                                                <div class="flex items-center justify-end space-x-2">
                                                    <% if (booking.status !== 'completed' && booking.status !== 'cancelled') { %>
                                                        <!-- Express Route Action: Complete -->
                                                        <form action="/owner/bookings/<%= booking._id %>/status?_method=PUT" method="POST" class="inline">
                                                            <input type="hidden" name="status" value="completed">
                                                            <button type="submit" title="Mark Completed" class="w-8 h-8 rounded-full bg-gold-400/10 border border-gold-400/30 text-gold-400 hover:bg-gold-400 hover:text-black flex items-center justify-center transition-all">
                                                                <i class="fa-solid fa-check text-xs"></i>
                                                            </button>
                                                        </form>

                                                        <!-- Express Route Action: Cancel -->
                                                        <form action="/owner/bookings/<%= booking._id %>/status?_method=PUT" method="POST" class="inline" onsubmit="return confirm('Cancel this reservation?')">
                                                            <input type="hidden" name="status" value="cancelled">
                                                            <button type="submit" title="Cancel Booking" class="w-8 h-8 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 hover:bg-red-500 hover:text-white flex items-center justify-center transition-all">
                                                                <i class="fa-solid fa-xmark text-xs"></i>
                                                            </button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="text-[10px] text-gray-500 italic">Archived</span>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colSpan="6" class="p-12 text-center text-gray-500 font-serif">
                                            No guest reservations logged yet.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- SECTION 6: AVAILABILITY BARS -->
            <section class="space-y-6">
                <div class="border-b border-white/10 pb-4">
                    <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Service Capacity</span>
                    <h2 class="font-serif text-2xl text-white mt-1">Slot Occupancy Breakdown</h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <% 
                        const defaultSlots = ['17:00', '18:00', '19:00', '20:00', '21:00', '22:00'];
                        const activeSlots = (restaurant.availableSlots && restaurant.availableSlots.length > 0) ? restaurant.availableSlots : defaultSlots;
                        const totalSeatsPerSlot = restaurant.totalSeats || 40;
                    %>

                    <% activeSlots.forEach(slot => { %>
                        <% 
                            // Calculate booked seats for this slot
                            let bookedInSlot = 0;
                            if (ownerBookings) {
                                ownerBookings.filter(b => b.time === slot && b.status !== 'cancelled').forEach(b => {
                                    bookedInSlot += (parseInt(b.guests) || 1);
                                });
                            }
                            const pct = Math.min(100, Math.round((bookedInSlot / totalSeatsPerSlot) * 100));
                        %>
                        <div class="glass-panel p-5 rounded-2xl border border-white/10 space-y-3">
                            <div class="flex justify-between items-center">
                                <span class="font-serif text-lg text-white"><%= slot %></span>
                                <span class="text-xs text-gold-400 font-semibold"><%= bookedInSlot %> / <%= totalSeatsPerSlot %> Seats</span>
                            </div>

                            <div class="w-full h-2 rounded-full bg-dark-800 border border-white/5 overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-gold-500 to-gold-400 rounded-full transition-all duration-500" style="width: <%= pct %>%;"></div>
                            </div>

                            <div class="flex justify-between items-center text-[10px] text-gray-400">
                                <span>Occupancy: <%= pct %>%</span>
                                <span class="<%= pct >= 80 ? 'text-amber-400' : 'text-emerald-400' %> font-medium">
                                    <%= pct >= 100 ? 'Fully Booked' : (totalSeatsPerSlot - bookedInSlot) + ' Seats Left' %>
                                </span>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>

            <!-- SECTION 5: EDITABLE RESTAURANT INFORMATION FORM -->
            <section id="edit-section" class="space-y-6">
                <div class="border-b border-white/10 pb-4">
                    <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Configuration</span>
                    <h2 class="font-serif text-2xl text-white mt-1">Restaurant Specifications</h2>
                </div>

                <form action="/owner/restaurant/update?_method=PUT" method="POST" class="glass-panel p-8 rounded-3xl border border-gold-400/20 space-y-6">
                    <input type="hidden" name="restaurantId" value="<%= restaurant._id %>">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Restaurant Name</label>
                            <input type="text" name="name" value="<%= restaurant.name %>" required class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Executive Chef</label>
                            <input type="text" name="chef" value="<%= restaurant.chef || '' %>" placeholder="e.g. Jean-Luc Vasseur" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Cuisine Type</label>
                            <input type="text" name="cuisine" value="<%= restaurant.cuisine || '' %>" placeholder="e.g. French Contemporary" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Price Tier</label>
                            <select name="priceRange" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400 cursor-pointer">
                                <option value="$" <%= restaurant.priceRange === '$' ? 'selected' : '' %>>$ — Casual Fine</option>
                                <option value="$$" <%= restaurant.priceRange === '$$' ? 'selected' : '' %>>$$ — Premium</option>
                                <option value="$$$" <%= restaurant.priceRange === '$$$' ? 'selected' : '' %>>$$$ — Haute Cuisine</option>
                                <option value="$$$$" <%= (!restaurant.priceRange || restaurant.priceRange === '$$$$') ? 'selected' : '' %>>$$$$ — Ultra Exclusive</option>
                            </select>
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Location / Neighborhood</label>
                            <input type="text" name="location" value="<%= restaurant.location || '' %>" required class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Street Address</label>
                            <input type="text" name="address" value="<%= restaurant.address || '' %>" required class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Opening Time</label>
                            <input type="time" name="openingTime" value="<%= restaurant.openingTime || '17:00' %>" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400 [color-scheme:dark]">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Closing Time</label>
                            <input type="time" name="closingTime" value="<%= restaurant.closingTime || '23:00' %>" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400 [color-scheme:dark]">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Total Seats Capacity</label>
                            <input type="number" name="totalSeats" value="<%= restaurant.totalSeats || 40 %>" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>

                        <div>
                            <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Total Dining Tables</label>
                            <input type="number" name="totalTables" value="<%= restaurant.totalTables || 10 %>" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-3.5 focus:outline-none focus:border-gold-400">
                        </div>
                    </div>

                    <div>
                        <label class="text-xs uppercase tracking-widest text-gray-400 font-semibold block mb-2">Description</label>
                        <textarea name="description" rows="4" class="w-full bg-dark-900 border border-white/10 text-xs text-white rounded-xl p-4 focus:outline-none focus:border-gold-400"><%= restaurant.description || '' %></textarea>
                    </div>

                    <div class="flex justify-end pt-4 border-t border-white/10">
                        <button type="submit" class="px-8 py-4 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all shadow-lg shadow-gold-500/20">
                            Save Changes
                        </button>
                    </div>
                </form>
            </section>

            <!-- SECTION 7: PERFORMANCE & BENCHMARKS -->
            <section class="glass-panel p-8 rounded-3xl border border-white/10 space-y-6">
                <div class="border-b border-white/10 pb-4">
                    <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Analytics</span>
                    <h2 class="font-serif text-2xl text-white mt-1">Performance Benchmarks</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
                    <div class="p-6 rounded-2xl bg-dark-900/60 border border-white/5 space-y-2">
                        <span class="text-xs uppercase tracking-widest text-gray-400">Public Rating</span>
                        <div class="text-gold-400 text-2xl font-serif font-bold">
                            <i class="fa-solid fa-star mr-1"></i> <%= restaurant.averageRating || '4.9' %> / 5.0
                        </div>
                        <p class="text-[10px] text-gray-500">Based on <%= restaurant.totalReviews || 128 %> verified patrons</p>
                    </div>

                    <div class="p-6 rounded-2xl bg-dark-900/60 border border-white/5 space-y-2">
                        <span class="text-xs uppercase tracking-widest text-gray-400">OpenDine Curation</span>
                        <div class="text-white text-xl font-serif font-semibold mt-1">
                            <%= restaurant.featured ? 'Featured Collection' : 'Standard Collection' %>
                        </div>
                        <p class="text-[10px] text-gold-400">Curated Michelin Standard</p>
                    </div>

                    <div class="p-6 rounded-2xl bg-dark-900/60 border border-white/5 space-y-2">
                        <span class="text-xs uppercase tracking-widest text-gray-400">Exclusivity Status</span>
                        <div class="text-gold-400 text-xl font-serif font-semibold mt-1">
                            <%= restaurant.exclusive ? 'Exclusive Tier' : 'Standard Tier' %>
                        </div>
                        <p class="text-[10px] text-gray-500">Concierge Desk Priority</p>
                    </div>
                </div>
            </section>

        <% } else { %>
            
            <!-- EMPTY STATE: NO RESTAURANT REGISTERED -->
            <section class="glass-panel rounded-3xl p-16 text-center border border-white/10 my-12 space-y-6 max-w-2xl mx-auto">
                <div class="w-20 h-20 mx-auto rounded-full bg-gold-400/10 text-gold-400 flex items-center justify-center text-3xl border border-gold-400/30">
                    <i class="fa-solid fa-utensils"></i>
                </div>
                <div class="space-y-2">
                    <h2 class="font-serif text-3xl text-white">No Restaurant Registered</h2>
                    <p class="text-xs text-gray-400 max-w-md mx-auto leading-relaxed">
                        You have not linked a dining establishment to your owner profile yet. Register your restaurant to begin accepting reservations.
                    </p>
                </div>
                <a href="/owner/restaurant/new" class="inline-block px-8 py-4 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 text-black font-semibold text-xs uppercase tracking-widest hover:from-gold-400 hover:to-gold-300 transition-all shadow-lg shadow-gold-500/20">
                    Register Establishment
                </a>
            </section>

        <% } %>

    </div>

    <!-- GSAP & Vanilla JS Logic -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        // 1. User Dropdown Toggle
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const dropdownArrow = document.getElementById('dropdown-arrow');

        if (userMenuBtn && userDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userDropdown.classList.contains('hidden');
                if (isHidden) {
                    userDropdown.classList.remove('hidden');
                    setTimeout(() => {
                        userDropdown.classList.remove('opacity-0', 'scale-95');
                        userDropdown.classList.add('opacity-100', 'scale-100');
                        if (dropdownArrow) dropdownArrow.classList.add('rotate-180');
                    }, 10);
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                    closeDropdown();
                }
            });

            function closeDropdown() {
                userDropdown.classList.remove('opacity-100', 'scale-100');
                userDropdown.classList.add('opacity-0', 'scale-95');
                if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
                setTimeout(() => userDropdown.classList.add('hidden'), 200);
            }
        }

        // 2. Booking Table Search & Filter Logic
        const searchInput = document.getElementById('booking-search');
        const filterSelect = document.getElementById('booking-filter-status');
        const tableRows = document.querySelectorAll('.booking-row');

        function filterTable() {
            const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const statusFilter = filterSelect ? filterSelect.value.toLowerCase() : 'all';

            tableRows.forEach(row => {
                const guestData = row.getAttribute('data-guest') || '';
                const rowStatus = row.getAttribute('data-status') || '';

                const matchesSearch = guestData.includes(query);
                const matchesStatus = (statusFilter === 'all') || (rowStatus === statusFilter);

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        if (searchInput) searchInput.addEventListener('input', filterTable);
        if (filterSelect) filterSelect.addEventListener('change', filterTable);

        // 3. GSAP Entrance Animations
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from('.hero-anim', { opacity: 0, y: 30, duration: 1, ease: 'power3.out' });
        });
    </script>
</body>
</html>
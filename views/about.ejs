<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Heritage & Passion — OpenDine</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FDF8EC',
                            300: '#E2C285',
                            400: '#D4AF37',
                            500: '#C59B27',
                            600: '#A37E1C',
                        },
                        dark: {
                            900: '#0B0C0E',
                            800: '#121418',
                            700: '#1C1F26',
                            600: '#2A2E39',
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .glass-panel {
            background: rgba(18, 20, 24, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.2);
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF0CA 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0C0E;
        }
        ::-webkit-scrollbar-thumb {
            background: #2A2E39;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
    </style>
</head>
<body class="bg-dark-900 text-gray-200 font-sans antialiased overflow-x-hidden selection:bg-gold-400 selection:text-black">

    <!-- NAVBAR -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-6 border-b border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
            <div class="flex items-center space-x-12">
                <a href="/" class="flex items-center space-x-3 group">
                    <span class="w-10 h-10 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 text-lg font-serif font-bold group-hover:border-gold-400 transition-colors">
                        O
                    </span>
                    <span class="font-serif text-2xl tracking-widest text-white font-semibold uppercase">
                        Open<span class="text-gold-400">Dine</span>
                    </span>
                </a>

                <nav class="hidden md:flex items-center space-x-8 text-xs font-medium uppercase tracking-widest">
                    <a href="/discover" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Discover</a>
                    <a href="/restaurants" class="text-gray-300 hover:text-gold-400 transition-colors duration-300">Restaurants</a>
                    <a href="/about" class="text-gold-400 font-semibold transition-colors duration-300">About Us</a>
                </nav>
            </div>

            <div class="flex items-center space-x-6">
                <% if(locals.user) { %>
                    <div class="relative" id="user-menu-container">
                        <button id="user-menu-btn" class="flex items-center space-x-3 focus:outline-none group p-1.5 rounded-full border border-gold-400/20 hover:border-gold-400 transition-all">
                            <img src="<%= user.avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150' %>" alt="<%= user.name %>" class="w-8 h-8 rounded-full object-cover border border-gold-400/50">
                            <span class="hidden sm:inline text-xs font-medium uppercase tracking-wider text-gray-200 group-hover:text-gold-400 transition-colors"><%= user.name %></span>
                            <i class="fa-solid fa-chevron-down text-xs text-gold-400 px-2 transition-transform duration-300" id="dropdown-arrow"></i>
                        </button>
                        <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 glass-panel rounded-xl shadow-2xl py-2 z-50 transform opacity-0 scale-95 transition-all duration-200">
                            <div class="px-4 py-3 border-b border-white/10">
                                <p class="text-xs text-gray-400">Signed in as</p>
                                <p class="text-sm font-semibold text-white truncate"><%= user.email %></p>
                            </div>
                            <a href="/profile" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors"><i class="fa-regular fa-user w-5"></i> Profile</a>
                            <a href="/bookings/myBookings" class="flex items-center px-4 py-2.5 text-xs text-gray-300 hover:bg-gold-400/10 hover:text-gold-400 transition-colors"><i class="fa-regular fa-bookmark w-5"></i> My Bookings</a>
                            <div class="border-t border-white/10 mt-1"></div>
                            <a href="/user/logout" class="flex items-center px-4 py-2.5 text-xs text-red-400 hover:bg-red-500/10 transition-colors"><i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Logout</a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/user/login" class="text-xs font-semibold uppercase tracking-widest text-white hover:text-gold-400 transition-colors">Log In</a>
                    <a href="/user/signup" class="px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-gradient-to-r from-gold-500 to-gold-400 text-black hover:from-gold-400 hover:to-gold-300 transition-all duration-300 shadow-lg shadow-gold-500/20">Sign Up</a>
                <% } %>
            </div>
        </div>
    </header>

    <!-- HERO -->
    <section class="pt-40 pb-20 px-6 lg:px-12 max-w-7xl mx-auto text-center space-y-6 hero-anim">
        <span class="inline-block text-xs uppercase tracking-[0.3em] text-gold-400 font-semibold px-4 py-1.5 rounded-full border border-gold-400/30 glass-panel">
            OpenDine Concierge Manifesto
        </span>
        <h1 class="font-serif text-5xl md:text-7xl font-normal text-white max-w-4xl mx-auto leading-tight">
            Our Passion for <span class="italic font-light text-[#C8A04A]">Extraordinary</span> Dining
        </h1>
        <p class="text-xs md:text-sm text-gray-400 max-w-xl mx-auto font-light leading-relaxed">
            Redefining table reservations through real-time concierge synchronization, curated Michelin-grade standards, and personal patron access.
        </p>
    </section>

    <!-- COMPANY STORY & MISSION / VISION -->
    <section class="py-20 px-6 lg:px-12 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="relative h-[500px] rounded-3xl overflow-hidden border border-gold-400/30 shadow-2xl">
            <img src="https://images.unsplash.com/photo-1559339352-11d035aa65de?auto=format&fit=crop&q=80&w=1200" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-transparent to-transparent"></div>
        </div>

        <div class="space-y-8">
            <div class="space-y-3">
                <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Origin & Philosophy</span>
                <h2 class="font-serif text-4xl text-white">The OpenDine Story</h2>
                <p class="text-xs text-gray-300 leading-relaxed font-light">
                    Founded with a singular vision to bridge discerning diners with world-class chefs, OpenDine eliminates reservation friction. We treat every table request not as a transaction, but as the curtain-raiser to a memorable celebration.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-white/10">
                <div class="space-y-2">
                    <h4 class="font-serif text-xl text-gold-400">Our Mission</h4>
                    <p class="text-xs text-gray-400 leading-relaxed">To curate seamless access to the world’s most coveted culinary tables through flawless technology.</p>
                </div>
                <div class="space-y-2">
                    <h4 class="font-serif text-xl text-gold-400">Our Vision</h4>
                    <p class="text-xs text-gray-400 leading-relaxed">To become the global gold standard for luxury hospitality reservations and private dining concierge.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- LUXURY NUMBERS -->
    <section class="py-20 bg-dark-800 border-y border-white/5">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div class="p-8 rounded-3xl glass-panel space-y-2 border border-gold-400/20">
                <p class="font-serif text-5xl text-gold-400 font-normal">500+</p>
                <p class="text-xs uppercase tracking-widest text-white font-semibold">Curated Restaurants</p>
                <p class="text-[10px] text-gray-500">Verified Michelin & Fine Dining Listings</p>
            </div>
            <div class="p-8 rounded-3xl glass-panel space-y-2 border border-gold-400/20">
                <p class="font-serif text-5xl text-white font-normal">20+</p>
                <p class="text-xs uppercase tracking-widest text-gold-400 font-semibold">Metropolitan Capitals</p>
                <p class="text-[10px] text-gray-500">Nationwide Elite Dining Hubs</p>
            </div>
            <div class="p-8 rounded-3xl glass-panel space-y-2 border border-gold-400/20">
                <p class="font-serif text-5xl text-gold-400 font-normal">50,000+</p>
                <p class="text-xs uppercase tracking-widest text-white font-semibold">Discerning Patrons</p>
                <p class="text-[10px] text-gray-500">Seamless Reservations Confirmed</p>
            </div>
        </div>
    </section>

    <!-- LUXURY VALUES -->
    <section class="py-28 px-6 lg:px-12 max-w-7xl mx-auto">
        <div class="text-center max-w-xl mx-auto mb-16 space-y-3">
            <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Core Pillars</span>
            <h2 class="font-serif text-4xl text-white">The Luxury Standard</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="p-8 rounded-3xl glass-panel border border-white/10 space-y-4 hover:border-gold-400/40 transition-all">
                <div class="w-12 h-12 rounded-full bg-gold-400/10 text-gold-400 flex items-center justify-center text-xl"><i class="fa-solid fa-gem"></i></div>
                <h3 class="font-serif text-xl text-white">Uncompromising Quality</h3>
                <p class="text-xs text-gray-400 leading-relaxed">Every establishment undergoes rigorous multi-point evaluation prior to platform integration.</p>
            </div>

            <div class="p-8 rounded-3xl glass-panel border border-white/10 space-y-4 hover:border-gold-400/40 transition-all">
                <div class="w-12 h-12 rounded-full bg-gold-400/10 text-gold-400 flex items-center justify-center text-xl"><i class="fa-solid fa-shield-halved"></i></div>
                <h3 class="font-serif text-xl text-white">Absolute Trust</h3>
                <p class="text-xs text-gray-400 leading-relaxed">Guaranteed table holds, encrypted billing deposits, and verified guest reviews.</p>
            </div>

            <div class="p-8 rounded-3xl glass-panel border border-white/10 space-y-4 hover:border-gold-400/40 transition-all">
                <div class="w-12 h-12 rounded-full bg-gold-400/10 text-gold-400 flex items-center justify-center text-xl"><i class="fa-solid fa-crown"></i></div>
                <h3 class="font-serif text-xl text-white">Curated Experiences</h3>
                <p class="text-xs text-gray-400 leading-relaxed">Direct chef table access, custom sommelier notes, and tailored anniversary seating.</p>
            </div>

            <div class="p-8 rounded-3xl glass-panel border border-white/10 space-y-4 hover:border-gold-400/40 transition-all">
                <div class="w-12 h-12 rounded-full bg-gold-400/10 text-gold-400 flex items-center justify-center text-xl"><i class="fa-solid fa-microchip"></i></div>
                <h3 class="font-serif text-xl text-white">Concierge Innovation</h3>
                <p class="text-xs text-gray-400 leading-relaxed">Real-time table inventory matching engine with zero wait times.</p>
            </div>
        </div>
    </section>

    <!-- MEET THE PLATFORM (TIMELINE) -->
    <section class="py-24 bg-dark-800 border-t border-white/5 px-6 lg:px-12">
        <div class="max-w-4xl mx-auto space-y-12">
            <div class="text-center space-y-3">
                <span class="text-xs uppercase tracking-[0.25em] text-gold-400 font-semibold">Evolution</span>
                <h2 class="font-serif text-4xl text-white">Platform Journey</h2>
            </div>

            <div class="space-y-8 relative border-l border-gold-400/30 pl-8 ml-4 sm:ml-32">
                <div class="relative space-y-2">
                    <span class="absolute -left-[41px] top-1 w-4 h-4 rounded-full bg-gold-400 border-4 border-dark-900"></span>
                    <span class="text-xs uppercase tracking-widest text-gold-400 font-semibold">2024 • Conception</span>
                    <h4 class="font-serif text-xl text-white">The Concierge Prototype</h4>
                    <p class="text-xs text-gray-400 leading-relaxed">Launched exclusive table reservation trials with top Michelin-star chefs in Mumbai & Delhi.</p>
                </div>

                <div class="relative space-y-2">
                    <span class="absolute -left-[41px] top-1 w-4 h-4 rounded-full bg-gold-400 border-4 border-dark-900"></span>
                    <span class="text-xs uppercase tracking-widest text-gold-400 font-semibold">2025 • Nationwide Scale</span>
                    <h4 class="font-serif text-xl text-white">20 Metro Expansion</h4>
                    <p class="text-xs text-gray-400 leading-relaxed">Integrated real-time table sync systems across 300+ luxury hotel restaurants and independent estates.</p>
                </div>

                <div class="relative space-y-2">
                    <span class="absolute -left-[41px] top-1 w-4 h-4 rounded-full bg-gold-400 border-4 border-dark-900"></span>
                    <span class="text-xs uppercase tracking-widest text-gold-400 font-semibold">2026 • Private Reserve</span>
                    <h4 class="font-serif text-xl text-white">OpenDine Elite Desk</h4>
                    <p class="text-xs text-gray-400 leading-relaxed">Introduced instant booking drawers, guest preferences logging, and owner portal dashboard controls.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-dark-900 border-t border-white/10 pt-20 pb-12 text-gray-400">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
                <div class="space-y-4">
                    <a href="/" class="flex items-center space-x-3">
                        <span class="w-8 h-8 rounded-full border border-gold-400/40 flex items-center justify-center bg-dark-800 text-gold-400 font-serif font-bold">O</span>
                        <span class="font-serif text-xl tracking-widest text-white font-semibold uppercase">Open<span class="text-gold-400">Dine</span></span>
                    </a>
                    <p class="text-xs text-gray-500 leading-relaxed">The premier table booking platform for Michelin-starred and luxury culinary destinations.</p>
                </div>
                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Platform</h5>
                    <ul class="space-y-2.5 text-xs">
                        <li><a href="/discover" class="hover:text-gold-400 transition-colors">Discover</a></li>
                        <li><a href="/restaurants" class="hover:text-gold-400 transition-colors">Restaurants</a></li>
                        <li><a href="/about" class="hover:text-gold-400 transition-colors">About Us</a></li>
                        <li><a href="/privacy" class="hover:text-gold-400 transition-colors">Privacy Policy</a></li>
                    </ul>
                </div>
                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Information</h5>
                    <ul class="space-y-2.5 text-xs">
                        <li><a href="#" class="hover:text-gold-400 transition-colors">Concierge Desk</a></li>
                        <li><a href="#" class="hover:text-gold-400 transition-colors">Partner Portal</a></li>
                        <li><a href="#" class="hover:text-gold-400 transition-colors">Terms of Service</a></li>
                    </ul>
                </div>
                <div>
                    <h5 class="text-xs font-semibold uppercase tracking-widest text-white mb-4">Connect</h5>
                    <p class="text-xs text-gray-500 mb-2">Concierge: concierge@opendine.com</p>
                </div>
            </div>
            <div class="border-t border-white/5 pt-8 flex flex-col md:flex-row items-center justify-between text-[11px] text-gray-500">
                <p>&copy; 2026 OpenDine Inc. All rights reserved.</p>
                <p class="mt-2 md:mt-0 uppercase tracking-widest text-[9px]">Crafted for Exceptional Taste</p>
            </div>
        </div>
    </footer>

    <!-- GSAP Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script>
        // Sticky Navbar
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('glass-panel', 'py-4');
                navbar.classList.remove('py-6');
            } else {
                navbar.classList.remove('glass-panel', 'py-4');
                navbar.classList.add('py-6');
            }
        });

        // Dropdown toggle
        const userMenuBtn = document.getElementById('user-menu-btn');
        const userDropdown = document.getElementById('user-dropdown');
        const dropdownArrow = document.getElementById('dropdown-arrow');

        if (userMenuBtn && userDropdown) {
            userMenuBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = userDropdown.classList.contains('hidden');
                if (isHidden) {
                    userDropdown.classList.remove('hidden');
                    setTimeout(() => {
                        userDropdown.classList.remove('opacity-0', 'scale-95');
                        userDropdown.classList.add('opacity-100', 'scale-100');
                        if (dropdownArrow) dropdownArrow.classList.add('rotate-180');
                    }, 10);
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', (e) => {
                if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
                    closeDropdown();
                }
            });

            function closeDropdown() {
                userDropdown.classList.remove('opacity-100', 'scale-100');
                userDropdown.classList.add('opacity-0', 'scale-95');
                if (dropdownArrow) dropdownArrow.classList.remove('rotate-180');
                setTimeout(() => userDropdown.classList.add('hidden'), 200);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            gsap.from('.hero-anim', { opacity: 0, y: 30, duration: 1, ease: 'power3.out' });
        });
    </script>
</body>
</html>